<UserControl x:Class="ConditioningControlPanel.Views.Controls.Studio.WallpaperFeatureControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             xmlns:helpers="clr-namespace:ConditioningControlPanel.Helpers"
             xmlns:feat="clr-namespace:ConditioningControlPanel.Features"
             mc:Ignorable="d" d:DesignWidth="760">

    <!-- STUDIO RACK · WALLPAPER (moved from Settings, 7.2.1). Settings keys are the Collage* ones.
         Root MUST stay a Panel (the session-lock banner goes in it) and the master MUST stay named
         ChkEnable (the lock painter finds it by name). Every control a session owns is marked. -->

    <StackPanel>

        <!-- HERO. The right margin on the text keeps a long translation off the pill. -->
        <Border Height="72" CornerRadius="16" Margin="0,0,0,10"
                Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{StaticResource SectionHueStudioBorderBrush}" BorderThickness="2">
            <Grid ClipToBounds="True">
                <Border Width="240" HorizontalAlignment="Right" CornerRadius="0,16,16,0">
                    <Border.Background>
                        <ImageBrush x:Name="HeroArtBrush" Stretch="UniformToFill" AlignmentX="Right" Opacity="0.9">
                            <ImageBrush.ImageSource>
                                <BitmapImage UriSource="pack://application:,,,/Resources/features/wallpaper.png"
                                             DecodePixelWidth="480"/>
                            </ImageBrush.ImageSource>
                        </ImageBrush>
                    </Border.Background>
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#E6000000" Offset="0.55"/>
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>

                <StackPanel VerticalAlignment="Center" Margin="16,0,150,0">
                    <helpers:EmojiTextBlock Text="{loc:Str setting_wallpaper_enabled}" FontSize="17" FontWeight="Bold"
                                            Foreground="{StaticResource TextLightBrush}"/>
                    <TextBlock Text="{loc:Str tooltip_wallpaper_enabled}" FontSize="11.5"
                               ToolTip="{loc:Str tooltip_wallpaper_enabled}"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>

                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                        CornerRadius="9999" Padding="12,6"
                        Background="#8C131320" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Str btn_enable}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <CheckBox x:Name="ChkEnable" x:FieldModifier="internal"
                                  feat:SessionLock.Owned="True"
                                  Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                  Checked="ChkEnable_Changed" Unchecked="ChkEnable_Changed"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid feat:AdaptiveSideArt.CollapseBelow="700">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MaxWidth="780"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SettingCardStyle}" VerticalAlignment="Top">
                <Grid>
                    <Border Background="{StaticResource SectionHueStudioWashBrush}" CornerRadius="11"/>
                    <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                            Background="{StaticResource SectionHueStudioBrush}"/>
                    <StackPanel Margin="16,8,16,8">

                        <Grid MinHeight="36" ToolTip="{loc:Str tooltip_wallpaper_mode}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Str setting_wallpaper_mode}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"
                                       Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnWpStatic" x:FieldModifier="internal" Content="{loc:Str setting_wallpaper_static}"
                                        feat:SessionLock.Owned="True"
                                        Style="{StaticResource SmallPinkButton}" Padding="8,4" FontSize="11" VerticalAlignment="Center"
                                        ToolTip="{loc:Str tooltip_wallpaper_static}"
                                        Click="BtnWpMode_Click"/>
                                <Button x:Name="BtnWpDynamic" x:FieldModifier="internal" Content="{loc:Str setting_wallpaper_dynamic}"
                                        feat:SessionLock.Owned="True"
                                        Style="{StaticResource OutlineButton}" Padding="8,4" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"
                                        ToolTip="{loc:Str tooltip_wallpaper_dynamic}"
                                        Click="BtnWpMode_Click"/>
                                <Button x:Name="BtnWpOwn" x:FieldModifier="internal" Content="{loc:Str setting_wallpaper_own}"
                                        feat:SessionLock.Owned="True"
                                        Style="{StaticResource OutlineButton}" Padding="8,4" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"
                                        ToolTip="{loc:Str tooltip_wallpaper_own}"
                                        Click="BtnWpMode_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Why it will not run as picked: too few images, a desktop one write would lose, performance
                             mode, or this PC refused Dynamic. Collapsed when there is nothing to say. -->
                        <TextBlock x:Name="TxtWpHint" x:FieldModifier="internal" Margin="0,2,0,4" Visibility="Collapsed"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"/>

                        <Border Height="1" Margin="0,6" Background="{DynamicResource GlassBorderBrush}"/>

                        <Grid x:Name="RowWpOwnImage" MinHeight="34" Visibility="Collapsed" ToolTip="{loc:Str tooltip_wallpaper_own_image}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Str setting_wallpaper_own_image}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <TextBlock Grid.Column="1" x:Name="TxtWpOwnImage" x:FieldModifier="internal"
                                       Foreground="{StaticResource TextLightBrush}" FontSize="12"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                            <Button Grid.Column="2" x:Name="BtnWpOwnBrowse" x:FieldModifier="internal" Content="{loc:Str btn_wallpaper_own_browse}"
                                    feat:SessionLock.Owned="True"
                                    Style="{StaticResource OutlineButton}" Padding="8,4" FontSize="11" VerticalAlignment="Center"
                                    Click="BtnWpOwnBrowse_Click"/>
                        </Grid>

                        <Grid x:Name="RowWpRotate" MinHeight="34" ToolTip="{loc:Str tooltip_collage_rotate}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Str setting_collage_rotate}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"
                                       Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                            <CheckBox Grid.Column="1" x:Name="ChkWpRotate" x:FieldModifier="internal"
                                      feat:SessionLock.Owned="True"
                                      Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                      Checked="ChkWpRotate_Changed" Unchecked="ChkWpRotate_Changed"/>
                        </Grid>

                        <Grid x:Name="RowWpInterval" MinHeight="36" Visibility="Collapsed" ToolTip="{loc:Str tooltip_collage_wallpaper_interval}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Str setting_collage_wallpaper_interval}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" x:Name="SliderWpInterval" x:FieldModifier="internal"
                                    feat:SessionLock.Owned="True"
                                    Minimum="10" Maximum="300" VerticalAlignment="Center" Margin="10,0"
                                    ValueChanged="SliderWpInterval_Changed"/>
                            <TextBox Grid.Column="2" x:Name="TxtWpInterval" x:FieldModifier="internal"
                                     feat:SessionLock.Owned="True"
                                     Width="52" MaxLength="5" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Center" Padding="4,2" Margin="0,0,6,0"
                                     LostFocus="TxtWpInterval_LostFocus" KeyDown="TxtWpInterval_KeyDown"/>
                            <TextBlock Grid.Column="3" x:Name="TxtWpIntervalPretty" Text="60s" MinWidth="46" HorizontalAlignment="Left"
                                       VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PinkBrush}"/>
                        </Grid>

                        <Border Height="1" Margin="0,6" Background="{DynamicResource GlassBorderBrush}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="{loc:Str setting_wallpaper_run_with_ccp}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextLightBrush}"/>
                                <TextBlock Text="{loc:Str hint_wallpaper_run_with_ccp}"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="ChkWpRunWithCcp" x:FieldModifier="internal"
                                      feat:SessionLock.Owned="True"
                                      Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                      Checked="ChkWpRunWithCcp_Changed" Unchecked="ChkWpRunWithCcp_Changed"/>
                        </Grid>

                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="10,0,0,0" CornerRadius="14"
                    BorderThickness="2" BorderBrush="{StaticResource VelvetCardBorderBrush}"
                    VerticalAlignment="Stretch" MinHeight="200">
                <Border.Background>
                    <ImageBrush x:Name="SideArtBrush" Stretch="UniformToFill">
                        <ImageBrush.ImageSource>
                            <BitmapImage UriSource="pack://application:,,,/Resources/features/wallpaper.png"
                                         DecodePixelWidth="800"/>
                        </ImageBrush.ImageSource>
                    </ImageBrush>
                </Border.Background>
                <Border CornerRadius="12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Color="#66000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="0.45"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Border>
        </Grid>

    </StackPanel>
</UserControl>
