<UserControl x:Class="ConditioningControlPanel.Views.Controls.AppSettingsSections.WallpaperSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             mc:Ignorable="d" d:DesignWidth="760">

    <!-- ================================================================
         SETTINGS · WALLPAPER (its own section, directly under Monitors)

         Master "Wallpaper" toggle collapses everything when off. Mode is a
         mutually-exclusive Static / Dynamic / Own image choice:
           • Static    = the composed still-image collage (light engine).
           • Dynamic   = the same collage with its gifs moving, live behind the icons.
           • Own image = one picture the user picked, held for the session.
         Rotate + interval (10-300s) apply to Static and Dynamic; the layout
         always rolls at random (no layout picker for now). "Run with CCP"
         keeps the wallpaper up while CCP is open. Settings keys are the
         existing Collage* ones plus CollageMode / CollageOwnImagePath; runtime is driven through
         ApplyWallpaperEngine() in the code-behind.
         ================================================================ -->

    <StackPanel>
        <TextBlock Text="{loc:Str set2_section_wallpaper}" Style="{StaticResource SectionHeader}"/>

        <Border Style="{StaticResource SectionPanel}" Padding="0" Margin="0,0,0,10"
                BorderBrush="{StaticResource SectionHueDevicesBorderBrush}">
            <Grid>
                <Border CornerRadius="11" Background="{StaticResource SectionHueDevicesWashBrush}"/>
                <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                        Background="{StaticResource SectionHueDevicesBrush}"/>
                <StackPanel Margin="15,12,15,12">

                    <!-- Master: Wallpaper on/off (collapses the rest when off) -->
                    <Grid MinHeight="34" ToolTip="{loc:Str tooltip_wallpaper_enabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}" Text="{loc:Str setting_wallpaper_enabled}" Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                        <CheckBox Grid.Column="1" x:Name="ChkWpEnabled" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}" VerticalAlignment="Center" Checked="ChkWpEnabled_Changed" Unchecked="ChkWpEnabled_Changed"/>
                    </Grid>

                    <!-- Mode: Static / Dynamic / Own image (either-or). Three buttons in the Assets-tab
                         preset look: the selected one is filled pink (SmallPinkButton), the others
                         outlined (OutlineButton) - styles swapped in code-behind. -->
                    <Grid x:Name="RowWpMode" MinHeight="34" Margin="16,2,0,0" Visibility="Collapsed" ToolTip="{loc:Str tooltip_wallpaper_mode}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}" Text="{loc:Str setting_wallpaper_mode}" Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnWpStatic" x:FieldModifier="internal" Content="{loc:Str setting_wallpaper_static}"
                                    Style="{StaticResource SmallPinkButton}" Padding="8,4" FontSize="11" VerticalAlignment="Center"
                                    ToolTip="{loc:Str tooltip_wallpaper_static}"
                                    Click="BtnWpMode_Click"/>
                            <Button x:Name="BtnWpDynamic" x:FieldModifier="internal" Content="{loc:Str setting_wallpaper_dynamic}"
                                    Style="{StaticResource OutlineButton}" Padding="8,4" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"
                                    ToolTip="{loc:Str tooltip_wallpaper_dynamic}"
                                    Click="BtnWpMode_Click"/>
                            <Button x:Name="BtnWpOwn" x:FieldModifier="internal" Content="{loc:Str setting_wallpaper_own}"
                                    Style="{StaticResource OutlineButton}" Padding="8,4" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"
                                    ToolTip="{loc:Str tooltip_wallpaper_own}"
                                    Click="BtnWpMode_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Why it will not run as picked: too few images, a desktop one write would lose, performance
                         mode, or this PC refused Dynamic. Collapsed when there is nothing to say. -->
                    <TextBlock x:Name="TxtWpHint" x:FieldModifier="internal" Margin="16,2,0,4" Visibility="Collapsed"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"/>

                    <!-- Own image: the picked file + Browse (Own image mode only) -->
                    <Grid x:Name="RowWpOwnImage" MinHeight="34" Margin="32,0,0,0" Visibility="Collapsed" ToolTip="{loc:Str tooltip_wallpaper_own_image}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}" Text="{loc:Str setting_wallpaper_own_image}" Margin="0,0,14,0"/>
                        <TextBlock Grid.Column="1" x:Name="TxtWpOwnImage" x:FieldModifier="internal" Foreground="#FFE8E8F0" FontSize="12"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                        <Button Grid.Column="2" x:Name="BtnWpOwnBrowse" x:FieldModifier="internal" Content="{loc:Str btn_wallpaper_own_browse}"
                                Style="{StaticResource OutlineButton}" Padding="8,4" FontSize="11" VerticalAlignment="Center"
                                Click="BtnWpOwnBrowse_Click"/>
                    </Grid>

                    <!-- Rotate on/off -->
                    <Grid x:Name="RowWpRotate" MinHeight="34" Margin="16,0,0,0" Visibility="Collapsed" ToolTip="{loc:Str tooltip_collage_rotate}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}" Text="{loc:Str setting_collage_rotate}" Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                        <CheckBox Grid.Column="1" x:Name="ChkWpRotate" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}" VerticalAlignment="Center" Checked="ChkWpRotate_Changed" Unchecked="ChkWpRotate_Changed"/>
                    </Grid>

                    <!-- New wallpaper every (10-300s), shown when Rotate is on -->
                    <Grid x:Name="RowWpInterval" MinHeight="34" Margin="32,0,0,0" Visibility="Collapsed" ToolTip="{loc:Str tooltip_collage_wallpaper_interval}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}" Text="{loc:Str setting_collage_wallpaper_interval}" Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                        <Slider Grid.Column="1" x:Name="SliderWpInterval" Minimum="10" Maximum="300" VerticalAlignment="Center" Margin="10,0" ValueChanged="SliderWpInterval_Changed"/>
                        <TextBox Grid.Column="2" x:Name="TxtWpInterval" Width="52" MaxLength="5" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="4,2" Margin="0,0,6,0" LostFocus="TxtWpInterval_LostFocus" KeyDown="TxtWpInterval_KeyDown"/>
                        <TextBlock Grid.Column="3" x:Name="TxtWpIntervalPretty" Text="60s" MinWidth="46" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Grid>

                    <!-- Run with CCP (confirmed in the handler). The consequence line stays visible. All three
                         modes; shown while Wallpaper is on. -->
                    <Grid x:Name="RowWpRunWithCcp" Margin="16,8,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Str setting_wallpaper_run_with_ccp}"/>
                            <TextBlock Text="{loc:Str hint_wallpaper_run_with_ccp}"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ChkWpRunWithCcp" x:FieldModifier="internal"
                                  Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                  Checked="ChkWpRunWithCcp_Changed" Unchecked="ChkWpRunWithCcp_Changed"/>
                    </Grid>

                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
