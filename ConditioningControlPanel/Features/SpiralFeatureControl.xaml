<UserControl x:Class="ConditioningControlPanel.Features.SpiralFeatureControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ConditioningControlPanel.Controls"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             xmlns:helpers="clr-namespace:ConditioningControlPanel.Helpers"
             xmlns:feat="clr-namespace:ConditioningControlPanel.Features"
             xmlns:rows="clr-namespace:ConditioningControlPanel.Controls.Rows"
             xmlns:pv="clr-namespace:ConditioningControlPanel.Controls.Preview"
             rows:RowHue.TintSliders="True">

    <!-- Velvet Kit 2 density pass. The root IS the StackPanel (the old Grid wrapper is gone):
         MainWindow.SessionFeatureLock.cs inserts the session-lock banner at index 0 of
         content.Content, and into a Grid that banner would have overlapped the settings
         instead of sitting above them. Readable Rows: slider rows share one label column. -->
    <StackPanel Grid.IsSharedSizeScope="True">

        <!-- HERO -->
        <Border Height="72" CornerRadius="16" Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{StaticResource SectionHueStudioBorderBrush}" BorderThickness="2" Margin="0,0,0,10">
            <Grid>
                <Border CornerRadius="0,16,16,0" Width="240" HorizontalAlignment="Right">
                    <Border.Background>
                        <ImageBrush x:Name="HeroArtBrush" Stretch="UniformToFill" AlignmentX="Right" Opacity="0.9">
                            <ImageBrush.ImageSource>
                                <BitmapImage UriSource="pack://application:,,,/Resources/features/spiral_overlay.png" DecodePixelWidth="480"/>
                            </ImageBrush.ImageSource>
                        </ImageBrush>
                    </Border.Background>
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#E6000000" Offset="0.55"/>
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="18,0,0,0">
                    <helpers:EmojiTextBlock Text="{loc:Str label_spiral_overlay}" FontSize="17" FontWeight="Bold"
                                            Foreground="{StaticResource TextLightBrush}"/>
                    <TextBlock Text="{loc:Str tooltip_show_hypnotic_spiral_overlay}" FontSize="11.5"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" CornerRadius="99"
                        Background="#8C131320" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="12,5,8,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Str btn_enable}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <CheckBox x:Name="ChkEnable"
                                  feat:SessionLock.Owned="True"
                                  Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                  Checked="ChkEnable_Changed"
                                  Unchecked="ChkEnable_Changed"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- VELVET KIT 2 · ROUND 3 · DENSITY. The settings column is capped (3*, MaxWidth 780) so a
             slider stops being a ~1200px runway in the wide Studio detail pane, and the width that
             buys back becomes ONE big art card instead of dead margin. Everything below column 0 is
             the previous page contents moved verbatim - same names, handlers, lock markers and loc
             keys. Below 700px (the 520px feature popup) the art column collapses to zero and the
             settings retake the full width: Features/AdaptiveSideArt.cs. -->
        <Grid feat:AdaptiveSideArt.CollapseBelow="700">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MaxWidth="780"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <!-- ONE dense card: opacity, the randomize switch (#641), the monitor picker (#639). -->
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid>
                        <Border Background="{StaticResource SectionHueStudioWashBrush}" CornerRadius="11"/>
                        <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                                Background="{StaticResource SectionHueStudioBrush}"/>
                        <StackPanel Margin="16,8,16,8">

                            <feat:OptionSection Key="spiral.basics" Title="{loc:Str studio_section_basics}" Theme="Main">
                            <Grid Style="{StaticResource OptionRow}" Background="Transparent" ToolTip="{loc:Str tooltip_spiral_opacity_5_100}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="RowLabel"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" MinWidth="56"/>
                                </Grid.ColumnDefinitions>
                                <rows:RowLabel Grid.Column="0" Text="{loc:Str setting_opacity}" Emblem="Clear"/>
                                <Slider Grid.Column="1" x:Name="SliderOpacity" feat:OptionSection.Setting="SpiralOpacity"
                                        Minimum="5" Maximum="100" Value="15"
                                        feat:SessionLock.Owned="True" VerticalAlignment="Center" Margin="14,0"
                                        ValueChanged="SliderOpacity_Changed"/>
                                <rows:RowValue Grid.Column="2" x:Name="TxtOpacity" Text="15%"/>
                            </Grid>
                            </feat:OptionSection>

                            <feat:OptionSection Key="spiral.extras" Title="{loc:Str studio_section_extras}" Theme="Advanced" DefaultOpen="False">
                            <Grid Style="{StaticResource OptionRow}" Background="Transparent" ToolTip="{loc:Str tooltip_spiral_randomize}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <rows:RowLabel Grid.Column="0" Text="{loc:Str setting_spiral_randomize}" Emblem="Random"
                                               IsOn="{Binding IsChecked, ElementName=ChkRandomize}"/>
                                <CheckBox Grid.Column="1"
                                          x:Name="ChkRandomize"
                                          Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                          Checked="ChkRandomize_Changed"
                                          Unchecked="ChkRandomize_Changed"/>
                            </Grid>

                            <!-- User master for the SESSION corner GIF. Sessions and 28-day program
                                 days used to raise their corner spiral off the program template
                                 alone, with nothing here to switch it off. -->
                            <Grid Style="{StaticResource OptionRow}" Background="Transparent" ToolTip="{loc:Str tooltip_session_corner_gif_allowed}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <rows:RowLabel Grid.Column="0" Text="{loc:Str setting_session_corner_gif_allowed}" Emblem="Folder"
                                               IsOn="{Binding IsChecked, ElementName=ChkSessionCornerGif}" Margin="0,0,12,0"/>
                                <CheckBox Grid.Column="1"
                                          x:Name="ChkSessionCornerGif"
                                          Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                          Checked="ChkSessionCornerGif_Changed"
                                          Unchecked="ChkSessionCornerGif_Changed"/>
                            </Grid>

                            <Grid Style="{StaticResource OptionRow}" Background="Transparent" ToolTip="{loc:Str tooltip_effect_monitor}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <rows:RowLabel Grid.Column="0" Text="{loc:Str setting_effect_monitor}" Emblem="Screens"/>
                                <ComboBox Grid.Column="1"
                                          x:Name="CmbMonitor" feat:OptionSection.Setting="SpiralTargetMonitor"
                                          Width="180" VerticalAlignment="Center"
                                          Style="{DynamicResource RowComboBoxStyle}"
                                          DropDownOpened="CmbMonitor_DropDownOpened"
                                          SelectionChanged="CmbMonitor_Changed"/>
                            </Grid>
                            </feat:OptionSection>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Actions (kept above the library so they're reachable without scrolling) -->
                <!-- THE LOOM: weave your own spiral (also craftable inside DtRH) -->
                <Button x:Name="BtnOpenLoom"
                        Content="🌀 THE LOOM - weave your own spiral"
                        Style="{DynamicResource OutlineButton}"
                        Padding="12,10"
                        Margin="0,0,0,10"
                        Click="BtnOpenLoom_Click"/>

                <!-- Standalone corner-GIF overlays (independent of sessions) -->
                <Button x:Name="BtnCornerGifs"
                        Content="🖼 CORNER GIFs - pin a GIF to a screen corner"
                        Style="{DynamicResource OutlineButton}"
                        Padding="12,10"
                        Margin="0,0,0,10"
                        Click="BtnCornerGifs_Click"/>

                <!-- Select GIF (browse anywhere) -->
                <Button x:Name="BtnSelectGif"
                        Content="{loc:Str btn_select_gif}"
                        Style="{DynamicResource OutlineButton}"
                        Padding="12,10"
                        Margin="0,0,0,10"
                        Click="BtnSelectGif_Click"/>

                <!-- Spiral library: its own card - it is a picker, not a dial. -->
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid>
                        <Border Background="{StaticResource SectionHueStudioWashBrush}" CornerRadius="11"/>
                        <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                                Background="{StaticResource SectionHueStudioBrush}"/>
                        <StackPanel Margin="16,10,16,12">
                            <Grid Margin="0,0,0,10" Background="Transparent"
                                  ToolTip="{loc:Str tooltip_spiral_library}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="SPIRAL LIBRARY"
                                           Foreground="{StaticResource TextLightBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        x:Name="BtnOpenSpiralFolder"
                                        Content="{loc:Str btn_spiral_open_folder}"
                                        Style="{DynamicResource OutlineButton}"
                                        Padding="10,5"
                                        Margin="0,0,6,0"
                                        FontSize="11"
                                        Click="BtnOpenSpiralFolder_Click"/>
                                <Button Grid.Column="2"
                                        x:Name="BtnRefreshSpirals"
                                        Content="⟳ Refresh"
                                        Style="{DynamicResource OutlineButton}"
                                        Padding="10,5"
                                        FontSize="11"
                                        Click="BtnRefreshSpirals_Click"/>
                            </Grid>

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          MaxHeight="280">
                                <WrapPanel x:Name="SpiralLibraryPanel" Orientation="Horizontal"/>
                            </ScrollViewer>

                            <TextBlock x:Name="SpiralEmptyState"
                                       Visibility="Collapsed"
                                       Text="{loc:Str label_no_spirals_yet}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{loc:Str label_if_you_have_display_problems_try_setting_your}"
                           Foreground="#FFA500"
                           FontSize="11"
                           FontStyle="Italic"
                           TextWrapping="Wrap"
                           Opacity="0.8"
                           Margin="0,2,0,0"/>

                <!-- The gold V2 box (Controls/SuperBox): Super switch, BASIC sign, weekly try.
                     The Whirlpool's options sit in it, shown while the Whirlpool is picked
                     (Features/SpiralFeatureControl.Pool.cs). Opacity and monitor above still drive
                     the pool, so neither is repeated. -->
                <ctl:SuperBox x:Name="SuperBoxMain" Effect="Vortex">
                  <StackPanel x:Name="PoolRows" Visibility="Collapsed" rows:RowHue.Hue="#FFE08A"
                              Loaded="PoolSpiralRow_Loaded" Unloaded="PoolSpiralRow_Unloaded">
                    <Border Height="1" Background="#33FFE08A" Margin="0,2,0,6"/>
                    <!-- The pool's largest size, percent of the stock reach. -->
                    <Grid x:Name="PoolSizeRow" Style="{StaticResource OptionRow}" Background="Transparent"
                          ToolTip="{loc:Str tooltip_super_pool_size}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="RowLabel"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" MinWidth="56"/>
                        </Grid.ColumnDefinitions>
                        <rows:RowLabel Grid.Column="0" Text="{loc:Str super_pool_size}" Emblem="Big"/>
                        <Slider Grid.Column="1" x:Name="SliderPoolSize" feat:OptionSection.Setting="WhirlpoolSize" Minimum="50" Maximum="150" Value="100"
                                VerticalAlignment="Center" Margin="14,0" ValueChanged="SliderPoolSize_Changed"/>
                        <rows:RowValue Grid.Column="2" x:Name="TxtPoolSize" Text="100%"/>
                    </Grid>
                    <!-- Smallest size (ccp-bugs #1719): the pool never shrinks below this. 0 = as shipped, it can vanish. -->
                    <Grid x:Name="PoolSmallestRow" Style="{StaticResource OptionRow}" Background="Transparent"
                          ToolTip="{loc:Str tooltip_super_pool_smallest}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="RowLabel"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" MinWidth="56"/>
                        </Grid.ColumnDefinitions>
                        <rows:RowLabel Grid.Column="0" Text="{loc:Str super_pool_smallest}" Emblem="Big"/>
                        <Slider Grid.Column="1" x:Name="SliderPoolSmallest" feat:OptionSection.Setting="WhirlpoolSmallest" Minimum="0" Maximum="50" Value="0"
                                VerticalAlignment="Center" Margin="14,0" ValueChanged="SliderPoolSmallest_Changed"/>
                        <rows:RowValue Grid.Column="2" x:Name="TxtPoolSmallest" Text="0%"/>
                    </Grid>
                    <!-- Stay centred: the pool keeps to the middle of the screen at full size. -->
                    <Grid x:Name="PoolCentredRow" Style="{StaticResource OptionRow}" Background="Transparent"
                          ToolTip="{loc:Str tooltip_super_pool_centred}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <rows:RowLabel Grid.Column="0" Text="{loc:Str super_pool_centred}" Emblem="Where"
                                       IsOn="{Binding IsChecked, ElementName=ChkPoolCentred}" Margin="0,0,12,0"/>
                        <CheckBox Grid.Column="1" x:Name="ChkPoolCentred" feat:OptionSection.Setting="WhirlpoolStayCentred"
                                  Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                  Checked="ChkPoolCentred_Changed" Unchecked="ChkPoolCentred_Changed"/>
                    </Grid>
                    <!-- Restless pool (ccp-bugs #1707): grows while the mouse moves or clicks, calms at rest. -->
                    <Grid x:Name="PoolRestlessRow" Style="{StaticResource OptionRow}" Background="Transparent"
                          ToolTip="{loc:Str tooltip_super_pool_restless}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <rows:RowLabel Grid.Column="0" Text="{loc:Str super_pool_restless}" Emblem="Reacts"
                                       IsOn="{Binding IsChecked, ElementName=ChkPoolRestless}" Margin="0,0,12,0"/>
                        <CheckBox Grid.Column="1" x:Name="ChkPoolRestless" feat:OptionSection.Setting="WhirlpoolRestless"
                                  Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                  Checked="ChkPoolRestless_Changed" Unchecked="ChkPoolRestless_Changed"/>
                    </Grid>
                    <!-- Owner 2026-11-22 (gold box rule, 2 to 5 rows): the four rows players tune most stay on show,
                         the rest fold behind "More options". The fold opens on its own when a row inside is off its
                         default (SpiralFeatureControl.Pool.cs). -->
                    <feat:MoreFold x:Name="FoldPoolMore">
                      <StackPanel>
                        <!-- Always new Loom spirals, or one saved Loom spiral to hold. -->
                        <Grid x:Name="PoolSpiralRow" Style="{StaticResource OptionRow}" Background="Transparent"
                              ToolTip="{loc:Str tooltip_super_pool_spiral}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <rows:RowLabel Grid.Column="0" Text="{loc:Str super_pool_spiral}" Emblem="Spiral"/>
                            <ComboBox Grid.Column="1" x:Name="CmbPoolSpiral" feat:OptionSection.Setting="WhirlpoolSpiral" Width="180" VerticalAlignment="Center"
                                      Style="{DynamicResource RowComboBoxStyle}"
                                      SelectionChanged="CmbPoolSpiral_Changed"/>
                        </Grid>
                        <!-- How long each spiral holds before it melts into the next. Dims while one is held. -->
                        <Grid x:Name="PoolEveryRow" Style="{StaticResource OptionRow}" Background="Transparent"
                              ToolTip="{loc:Str tooltip_super_pool_every}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="RowLabel"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" MinWidth="56"/>
                            </Grid.ColumnDefinitions>
                            <rows:RowLabel Grid.Column="0" Text="{loc:Str super_pool_every}" Emblem="Often">
                                <rows:RowLabel.Value>
                                    <!-- A bigger number is LESS often: the period form of the fraction. -->
                                    <MultiBinding Converter="{x:Static rows:RowFraction.Inverse}">
                                        <Binding Path="Value" ElementName="SliderPoolEvery"/>
                                        <Binding Path="Maximum" ElementName="SliderPoolEvery"/>
                                        <Binding Path="Minimum" ElementName="SliderPoolEvery"/>
                                    </MultiBinding>
                                </rows:RowLabel.Value>
                            </rows:RowLabel>
                            <Slider Grid.Column="1" x:Name="SliderPoolEvery" feat:OptionSection.Setting="WhirlpoolNewEvery" Minimum="8" Maximum="60" Value="18"
                                    VerticalAlignment="Center" Margin="14,0" ValueChanged="SliderPoolEvery_Changed"/>
                            <rows:RowValue Grid.Column="2" x:Name="TxtPoolEvery" Text="18 s"/>
                        </Grid>
                        <!-- Moving effects pop: one setting, also in the Scrawl box. Off = the pool pulls but never eats. -->
                        <Grid x:Name="PoolPopsRow" Style="{StaticResource OptionRow}" Background="Transparent"
                              ToolTip="{loc:Str tooltip_super_moving_pops}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <rows:RowLabel Grid.Column="0" Text="{loc:Str super_moving_pops}" Emblem="Reacts"
                                           IsOn="{Binding IsChecked, ElementName=ChkPoolPops}" Margin="0,0,12,0"/>
                            <CheckBox Grid.Column="1" x:Name="ChkPoolPops" feat:OptionSection.Setting="MovingEffectsPop"
                                      Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                      Checked="ChkPoolPops_Changed" Unchecked="ChkPoolPops_Changed"/>
                        </Grid>
                        <!-- What the pool drags in: four switches, all on by default (words: owner 2026-11-18).
                             Readable Rows: each switch wears its effect's picture, so the four no longer fit on
                             the title's line; they sit under it as two tidy rows of two (a WrapPanel left
                             "Words" alone on a second line at the default window size, 7.4 desk run). -->
                        <StackPanel x:Name="PoolDragsRow" Background="Transparent"
                                    ToolTip="{loc:Str tooltip_super_pool_drags}">
                            <Grid Style="{StaticResource OptionRow}">
                                <rows:RowLabel Text="{loc:Str super_pool_drags}" Emblem="Reacts"/>
                            </Grid>
                            <UniformGrid x:Name="PoolDragsChips" Columns="2" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" Margin="0,4,22,4">
                                    <rows:RowLabel Text="{loc:Str super_pool_drags_fog}" Emblem="Fog" Margin="0,0,8,0"
                                                   IsOn="{Binding IsChecked, ElementName=ChkPoolDragsFog}"/>
                                    <CheckBox x:Name="ChkPoolDragsFog" Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                              Checked="ChkPoolDrags_Changed" Unchecked="ChkPoolDrags_Changed"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,22,4">
                                    <rows:RowLabel Text="{loc:Str super_pool_drags_pictures}" Emblem="Many" Subject="Image" Margin="0,0,8,0"
                                                   IsOn="{Binding IsChecked, ElementName=ChkPoolDragsPictures}"/>
                                    <CheckBox x:Name="ChkPoolDragsPictures" Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                              Checked="ChkPoolDrags_Changed" Unchecked="ChkPoolDrags_Changed"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,22,4">
                                    <rows:RowLabel Text="{loc:Str super_pool_drags_bubbles}" Emblem="Many" Subject="Bubble" Margin="0,0,8,0"
                                                   IsOn="{Binding IsChecked, ElementName=ChkPoolDragsBubbles}"/>
                                    <CheckBox x:Name="ChkPoolDragsBubbles" Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                              Checked="ChkPoolDrags_Changed" Unchecked="ChkPoolDrags_Changed"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,22,4">
                                    <rows:RowLabel Text="{loc:Str super_pool_drags_words}" Emblem="Words" Margin="0,0,8,0"
                                                   IsOn="{Binding IsChecked, ElementName=ChkPoolDragsWords}"/>
                                    <CheckBox x:Name="ChkPoolDragsWords" Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                              Checked="ChkPoolDrags_Changed" Unchecked="ChkPoolDrags_Changed"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                      </StackPanel>
                    </feat:MoreFold>
                  </StackPanel>
                </ctl:SuperBox>
            </StackPanel>

            <!-- SIDE ART -> LIVE PREVIEW (owner 2026-11-24): the card is a framed slice of a desktop where
                 the effect plays with fake content (Controls/Preview/EffectPreview.cs). The mod art brush stays
                 (ApplyFeatureArt writes it) but is parked in Tag, so nothing shows behind the preview; the card
                 keeps its size and its AdaptiveSideArt collapse. -->
            <Border Grid.Column="1" Margin="10,0,0,0" CornerRadius="14"
                    BorderThickness="2" BorderBrush="{StaticResource VelvetCardBorderBrush}"
                    Background="#06050D" VerticalAlignment="Stretch" MinHeight="200">
                <Border.Tag>
                    <ImageBrush x:Name="SideArtBrush" Stretch="UniformToFill"/>
                </Border.Tag>
                <pv:EffectPreview Scene="spiral"/>
            </Border>
        </Grid>

    </StackPanel>
</UserControl>
