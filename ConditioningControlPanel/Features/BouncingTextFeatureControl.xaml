<UserControl x:Class="ConditioningControlPanel.Features.BouncingTextFeatureControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ConditioningControlPanel.Controls"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             xmlns:helpers="clr-namespace:ConditioningControlPanel.Helpers"
             xmlns:feat="clr-namespace:ConditioningControlPanel.Features"
             xmlns:rows="clr-namespace:ConditioningControlPanel.Controls.Rows"
             xmlns:pv="clr-namespace:ConditioningControlPanel.Controls.Preview"
             rows:RowHue.TintSliders="True">

    <Grid>
        <StackPanel Grid.IsSharedSizeScope="True">
            <!-- HERO. Replaces the standalone Enable card: the checkbox moved into the pill
                 verbatim. This page's Enable card never carried a description of its own, so
                 the subtitle reuses this page's own XP line (which used to float loose above
                 the buttons) and the feature's long blurb becomes the hero ToolTip - no new
                 loc strings. Hero art is static pack-URI art, exempt from the mod repaint
                 map. -->
            <Border Height="72" CornerRadius="16" Margin="0,0,0,10"
                    Background="{DynamicResource SurfaceBgBrush}"
                    BorderBrush="{StaticResource SectionHueStudioBorderBrush}" BorderThickness="2"
                    ToolTip="{loc:Str tooltip_dvd_screensaver_style_bouncing_text_customiza}">
                <Grid ClipToBounds="True">
                    <Border Width="240" HorizontalAlignment="Right" CornerRadius="0,16,16,0">
                        <Border.Background>
                            <ImageBrush x:Name="HeroArtBrush" Stretch="UniformToFill" AlignmentX="Right" Opacity="0.9">
                                <ImageBrush.ImageSource>
                                    <BitmapImage UriSource="pack://application:,,,/Resources/features/bouncing_text.png"
                                                 DecodePixelWidth="480"/>
                                </ImageBrush.ImageSource>
                            </ImageBrush>
                        </Border.Background>
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#E6000000" Offset="0.55"/>
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                    </Border>

                    <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                        <helpers:EmojiTextBlock Text="{loc:Str label_bouncing_text}" FontSize="17" FontWeight="Bold"
                                                Foreground="{StaticResource TextLightBrush}"/>
                        <helpers:EmojiTextBlock Text="{loc:Str label_10_xp_per_bounce}" FontSize="11.5"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                            CornerRadius="9999" Padding="12,6"
                            Background="#8C131320" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Str btn_enable}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <CheckBox x:Name="ChkEnable" feat:SessionLock.Owned="True"
                                      Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                      Checked="ChkEnable_Changed" Unchecked="ChkEnable_Changed"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- VELVET KIT 2 · ROUND 3 · DENSITY. The settings column is capped (3*, MaxWidth 780) so a
                 slider stops being a ~1200px runway in the wide Studio detail pane, and the width that
                 buys back becomes ONE big art card instead of dead margin. Everything below column 0 is
                 the previous page contents moved verbatim - same names, handlers, lock markers and loc
                 keys. Below 700px (the 520px feature popup) the art column collapses to zero and the
                 settings retake the full width: Features/AdaptiveSideArt.cs. -->
            <Grid feat:AdaptiveSideArt.CollapseBelow="700">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MaxWidth="780"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <!-- ONE dense controls card: the three dials, the colour mode, then the switches. -->
                    <Border Style="{StaticResource SettingCardStyle}">
                        <Grid>
                            <Border Background="{StaticResource SectionHueStudioWashBrush}" CornerRadius="11"/>
                            <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                                    Background="{StaticResource SectionHueStudioBrush}"/>
                            <StackPanel Margin="16,8,16,8">

                                <feat:OptionSection Key="bouncingtext.basics" Title="{loc:Str studio_section_basics}" Theme="Main">
                                <!-- Speed -->
                                <Grid Style="{StaticResource OptionRow}" ToolTip="{loc:Str tooltip_bounce_speed_1_slow_10_fast}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="RowLabel"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" MinWidth="56"/>
                                    </Grid.ColumnDefinitions>
                                    <rows:RowLabel Grid.Column="0" Text="{loc:Str setting_speed}" Emblem="Fast"/>
                                    <Slider Grid.Column="1" x:Name="SliderSpeed" feat:OptionSection.Setting="BouncingTextSpeed" Minimum="1" Maximum="10" Value="5"
                                            feat:SessionLock.Owned="True" VerticalAlignment="Center" Margin="10,0"
                                            ValueChanged="SliderSpeed_Changed"/>
                                    <rows:RowValue Grid.Column="2" x:Name="TxtSpeed" Text="5"/>
                                </Grid>

                                <!-- Size -->
                                <Grid Style="{StaticResource OptionRow}" ToolTip="{loc:Str tooltip_text_size_50_small_100_normal_300_huge}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="RowLabel"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" MinWidth="56"/>
                                    </Grid.ColumnDefinitions>
                                    <rows:RowLabel Grid.Column="0" Text="{loc:Str setting_size}" Emblem="Big"/>
                                    <Slider Grid.Column="1" x:Name="SliderSize" feat:OptionSection.Setting="BouncingTextSize" Minimum="50" Maximum="300" Value="100"
                                            feat:SessionLock.Owned="True" VerticalAlignment="Center" Margin="10,0"
                                            ValueChanged="SliderSize_Changed"/>
                                    <rows:RowValue Grid.Column="2" x:Name="TxtSize" Text="100%"/>
                                </Grid>

                                <!-- Opacity -->
                                <Grid Style="{StaticResource OptionRow}" ToolTip="{loc:Str tooltip_bouncing_text_opacity_10_ghostly_100_solid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="RowLabel"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" MinWidth="56"/>
                                    </Grid.ColumnDefinitions>
                                    <rows:RowLabel Grid.Column="0" Text="{loc:Str setting_opacity}" Emblem="Clear"/>
                                    <Slider Grid.Column="1" x:Name="SliderOpacity" feat:OptionSection.Setting="BouncingTextOpacity" Minimum="10" Maximum="100" Value="100"
                                            VerticalAlignment="Center" Margin="10,0"
                                            ValueChanged="SliderOpacity_Changed"/>
                                    <rows:RowValue Grid.Column="2" x:Name="TxtOpacity" Text="100%"/>
                                </Grid>
                                </feat:OptionSection>

                                <feat:OptionSection Key="bouncingtext.look" Title="{loc:Str studio_section_look}" Theme="Look">
                                <!-- Colour mode -->
                                <Grid Style="{StaticResource OptionRow}" ToolTip="{loc:Str tooltip_random_rerolls_every_bounce_fixed_keeps_one_c}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <rows:RowLabel Grid.Column="0" Text="{loc:Str setting_color_mode}" Emblem="Colour"/>
                                    <ComboBox Grid.Column="1" x:Name="CmbColorMode" feat:OptionSection.Setting="BouncingTextColorMode" Height="26" MaxWidth="220"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Style="{DynamicResource RowComboBoxStyle}"
                                              SelectionChanged="CmbColorMode_Changed">
                                        <ComboBoxItem Content="{loc:Str option_color_random}"/>
                                        <ComboBoxItem Content="{loc:Str option_color_fixed}"/>
                                        <ComboBoxItem Content="{loc:Str option_color_rainbow}"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Shown by code-behind only while "fixed" is the colour mode. -->
                                <Grid x:Name="PanelFixedColor" Height="36" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Str setting_text_color}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="ColorSwatch" Width="24" Height="24" CornerRadius="6"
                                                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                                Background="#FF69B4" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnChooseColor" Content="{loc:Str btn_choose_color}"
                                                Style="{StaticResource SmallPinkButton}" Click="BtnChooseColor_Click"/>
                                        <Button x:Name="BtnResetColor" Content="{loc:Str btn_reset}"
                                                Style="{StaticResource SmallPinkButton}" Click="BtnResetColor_Click"
                                                Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Font: any family installed on Windows, plus the bundled Fredoka. -->
                                <Grid Style="{StaticResource OptionRow}" ToolTip="{loc:Str tooltip_bouncing_font_any_installed}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <rows:RowLabel Grid.Column="0" Text="{loc:Str label_font}" Emblem="Words"/>
                                    <ComboBox Grid.Column="1" x:Name="CmbFont" feat:OptionSection.Setting="BouncingTextFont" Height="26" MaxWidth="220"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Style="{DynamicResource RowComboBoxStyle}"
                                              SelectionChanged="CmbFont_Changed"/>
                                </Grid>
                                </feat:OptionSection>

                                <feat:OptionSection Key="bouncingtext.extras" Title="{loc:Str studio_section_extras}" Theme="Advanced" DefaultOpen="False">
                                <!-- Second text -->
                                <Grid Style="{StaticResource OptionRow}" ToolTip="{loc:Str tooltip_second_independent_bouncing_text}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <rows:RowLabel Grid.Column="0" Text="{loc:Str setting_second_text}" Emblem="Words"
                                                   IsOn="{Binding IsChecked, ElementName=ChkSecondText}"/>
                                    <CheckBox Grid.Column="1" x:Name="ChkSecondText"
                                              Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                              Checked="ChkSecondText_Changed" Unchecked="ChkSecondText_Changed"/>
                                </Grid>

                                <!-- Show over videos -->
                                <Grid Style="{StaticResource OptionRow}" ToolTip="{loc:Str tooltip_keep_bouncing_text_visible_on_top_of_fullscre}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <rows:RowLabel Grid.Column="0" Text="{loc:Str setting_show_over_videos}" Emblem="Layers"
                                                   IsOn="{Binding IsChecked, ElementName=ChkAlwaysOnTop}"/>
                                    <CheckBox Grid.Column="1" x:Name="ChkAlwaysOnTop"
                                              Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                              Checked="ChkAlwaysOnTop_Changed" Unchecked="ChkAlwaysOnTop_Changed"/>
                                </Grid>
                                </feat:OptionSection>

                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Effects: its own card, same row grammar, two columns because the seven
                         switches are peers and none of them needs a line of prose. -->
                    <Border Style="{StaticResource SettingCardStyle}"
                            ToolTip="{loc:Str tooltip_bouncing_text_effects_combine_freely}">
                        <Grid>
                            <Border Background="{StaticResource SectionHueStudioWashBrush}" CornerRadius="11"/>
                            <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                                    Background="{StaticResource SectionHueStudioBrush}"/>
                            <StackPanel Margin="16,8,16,8">
                                <feat:OptionSection Key="bouncingtext.effects" Title="{loc:Str studio_section_effects}" Theme="Look">
                                <!-- Readable Rows: one switch per line (owner: rows stay single column). -->
                                <StackPanel>
                                    <Grid Style="{StaticResource OptionRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <rows:RowLabel Grid.Column="0" Text="{loc:Str setting_fx_breathing}" Emblem="Motion"
                                                       IsOn="{Binding IsChecked, ElementName=ChkFxBreathing}"/>
                                        <CheckBox Grid.Column="1" x:Name="ChkFxBreathing" Style="{StaticResource ToggleStyle}"
                                                  VerticalAlignment="Center" Checked="FxToggle_Changed" Unchecked="FxToggle_Changed"/>
                                    </Grid>
                                    <Grid Style="{StaticResource OptionRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <rows:RowLabel Grid.Column="0" Text="{loc:Str setting_fx_wobble}" Emblem="Motion"
                                                       IsOn="{Binding IsChecked, ElementName=ChkFxWobble}"/>
                                        <CheckBox Grid.Column="1" x:Name="ChkFxWobble" Style="{StaticResource ToggleStyle}"
                                                  VerticalAlignment="Center" Checked="FxToggle_Changed" Unchecked="FxToggle_Changed"/>
                                    </Grid>
                                    <Grid Style="{StaticResource OptionRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <rows:RowLabel Grid.Column="0" Text="{loc:Str setting_fx_spin}" Emblem="Motion"
                                                       IsOn="{Binding IsChecked, ElementName=ChkFxSpin}"/>
                                        <CheckBox Grid.Column="1" x:Name="ChkFxSpin" Style="{StaticResource ToggleStyle}"
                                                  VerticalAlignment="Center" Checked="FxToggle_Changed" Unchecked="FxToggle_Changed"/>
                                    </Grid>
                                    <Grid Style="{StaticResource OptionRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <rows:RowLabel Grid.Column="0" Text="{loc:Str setting_fx_velocity_tilt}" Emblem="Motion"
                                                       IsOn="{Binding IsChecked, ElementName=ChkFxVelocityTilt}"/>
                                        <CheckBox Grid.Column="1" x:Name="ChkFxVelocityTilt" Style="{StaticResource ToggleStyle}"
                                                  VerticalAlignment="Center" Checked="FxToggle_Changed" Unchecked="FxToggle_Changed"/>
                                    </Grid>
                                    <Grid Style="{StaticResource OptionRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <rows:RowLabel Grid.Column="0" Text="{loc:Str setting_fx_squash}" Emblem="Motion"
                                                       IsOn="{Binding IsChecked, ElementName=ChkFxSquash}"/>
                                        <CheckBox Grid.Column="1" x:Name="ChkFxSquash" Style="{StaticResource ToggleStyle}"
                                                  VerticalAlignment="Center" Checked="FxToggle_Changed" Unchecked="FxToggle_Changed"/>
                                    </Grid>
                                    <Grid Style="{StaticResource OptionRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <rows:RowLabel Grid.Column="0" Text="{loc:Str setting_fx_corner_burst}" Emblem="Corners"
                                                       IsOn="{Binding IsChecked, ElementName=ChkFxCornerBurst}"/>
                                        <CheckBox Grid.Column="1" x:Name="ChkFxCornerBurst" Style="{StaticResource ToggleStyle}"
                                                  VerticalAlignment="Center" Checked="FxToggle_Changed" Unchecked="FxToggle_Changed"/>
                                    </Grid>
                                    <Grid Style="{StaticResource OptionRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <rows:RowLabel Grid.Column="0" Text="{loc:Str setting_fx_outline}" Emblem="Colour"
                                                       IsOn="{Binding IsChecked, ElementName=ChkOutline}"/>
                                        <CheckBox Grid.Column="1" x:Name="ChkOutline" Style="{StaticResource ToggleStyle}"
                                                  VerticalAlignment="Center" Checked="ChkOutline_Changed" Unchecked="ChkOutline_Changed"/>
                                    </Grid>
                                </StackPanel>
                                </feat:OptionSection>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button Content="{loc:Str btn_edit_phrases}" Style="{DynamicResource OutlineButton}"
                            Click="BtnEditPhrases_Click"/>

                    <!-- The gold V2 box (Controls/SuperBox): Super switch, BASIC sign, weekly try.
                         Scrawl's own rows, shown while Scrawl is lit: Features/BouncingTextFeatureControl.Scrawl.cs. -->
                    <ctl:SuperBox x:Name="SuperBoxMain" Effect="Scrawl">
                        <StackPanel x:Name="ScrawlRows" Visibility="Collapsed" rows:RowHue.Hue="#FFE08A"
                                    Loaded="ScrawlRows_Loaded" Unloaded="ScrawlRows_Unloaded">
                            <Border Height="1" Background="#33FFE08A" Margin="0,2,0,6"/>
                            <Grid Style="{StaticResource OptionRow}" Background="Transparent" ToolTip="{loc:Str tooltip_super_scrawl_life}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="RowLabel"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" MinWidth="56"/>
                                </Grid.ColumnDefinitions>
                                <rows:RowLabel Grid.Column="0" Text="{loc:Str super_scrawl_life}" Emblem="Long"/>
                                <Slider Grid.Column="1" x:Name="SliderScrawlLife" feat:OptionSection.Setting="ScrawlStampSeconds" Minimum="3" Maximum="60" Value="14"
                                        SmallChange="1" LargeChange="1" TickFrequency="1" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" Margin="10,0"
                                        ValueChanged="SliderScrawlLife_Changed"/>
                                <rows:RowValue Grid.Column="2" x:Name="TxtScrawlLife" Text="14s"/>
                            </Grid>
                            <Grid Style="{StaticResource OptionRow}" Background="Transparent" ToolTip="{loc:Str tooltip_super_scrawl_cap}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="RowLabel"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" MinWidth="56"/>
                                </Grid.ColumnDefinitions>
                                <rows:RowLabel Grid.Column="0" Text="{loc:Str super_scrawl_cap}" Emblem="Most"
                                               Value="{Binding Value, ElementName=SliderScrawlCap}"/>
                                <Slider Grid.Column="1" x:Name="SliderScrawlCap" feat:OptionSection.Setting="ScrawlStampCap" Minimum="6" Maximum="80" Value="44"
                                        SmallChange="1" LargeChange="1" TickFrequency="1" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" Margin="10,0"
                                        ValueChanged="SliderScrawlCap_Changed"/>
                                <rows:RowValue Grid.Column="2" x:Name="TxtScrawlCap" Text="44" Unit="{loc:Str row_unit_at_most}"/>
                            </Grid>
                            <Grid Style="{StaticResource OptionRow}" Background="Transparent" ToolTip="{loc:Str tooltip_super_scrawl_size}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="RowLabel"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" MinWidth="56"/>
                                </Grid.ColumnDefinitions>
                                <rows:RowLabel Grid.Column="0" Text="{loc:Str super_scrawl_size}" Emblem="Big"/>
                                <Slider Grid.Column="1" x:Name="SliderScrawlSize" feat:OptionSection.Setting="ScrawlStampSize" Minimum="25" Maximum="150" Value="100"
                                        SmallChange="5" LargeChange="25" TickFrequency="5" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" Margin="10,0"
                                        ValueChanged="SliderScrawlSize_Changed"/>
                                <rows:RowValue Grid.Column="2" x:Name="TxtScrawlSize" Text="100%"/>
                            </Grid>
                            <Grid Style="{StaticResource OptionRow}" Background="Transparent" ToolTip="{loc:Str tooltip_super_scrawl_slam}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="RowLabel"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" MinWidth="56"/>
                                </Grid.ColumnDefinitions>
                                <rows:RowLabel Grid.Column="0" Text="{loc:Str super_scrawl_slam}" Emblem="Stamp"/>
                                <Slider Grid.Column="1" x:Name="SliderScrawlSlam" feat:OptionSection.Setting="ScrawlSlam" Minimum="0" Maximum="200" Value="100"
                                        SmallChange="25" LargeChange="25" TickFrequency="25" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" Margin="10,0"
                                        ValueChanged="SliderScrawlSlam_Changed"/>
                                <rows:RowValue Grid.Column="2" x:Name="TxtScrawlSlam" Text="100%"/>
                            </Grid>
                            <!-- Moving effects pop: one setting, also in the Whirlpool box. Off = the word sweeps nothing. -->
                            <Grid Style="{StaticResource OptionRow}" Background="Transparent" ToolTip="{loc:Str tooltip_super_moving_pops}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <rows:RowLabel Grid.Column="0" Text="{loc:Str super_moving_pops}" Emblem="Reacts" Margin="0,0,12,0"
                                               IsOn="{Binding IsChecked, ElementName=ChkScrawlPops}"/>
                                <CheckBox Grid.Column="1" x:Name="ChkScrawlPops" feat:OptionSection.Setting="MovingEffectsPop"
                                          Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                          Checked="ChkScrawlPops_Changed" Unchecked="ChkScrawlPops_Changed"/>
                            </Grid>
                        </StackPanel>
                    </ctl:SuperBox>
                </StackPanel>

                <!-- SIDE ART -> LIVE PREVIEW (sweep lane P2, owner 2026-11-24): the card is a framed slice of a desktop
                     where Bouncing Text plays with fake content (Controls/Preview/EffectPreview.cs). The mod art brush
                     stays (ApplyFeatureArt writes it) but is parked in Tag, so nothing shows behind the preview;
                     the card keeps its size and its AdaptiveSideArt collapse. -->
                <Border Grid.Column="1" Margin="10,0,0,0" CornerRadius="14"
                        BorderThickness="2" BorderBrush="{StaticResource VelvetCardBorderBrush}"
                        Background="#06050D" VerticalAlignment="Stretch" MinHeight="200">
                    <Border.Tag>
                        <ImageBrush x:Name="SideArtBrush" Stretch="UniformToFill"/>
                    </Border.Tag>
                    <pv:EffectPreview Scene="bouncingtext"/>
                </Border>
            </Grid>

        </StackPanel>
    </Grid>
</UserControl>
