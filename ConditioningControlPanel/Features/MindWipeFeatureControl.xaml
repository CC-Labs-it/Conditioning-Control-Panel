<UserControl x:Class="ConditioningControlPanel.Features.MindWipeFeatureControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             xmlns:helpers="clr-namespace:ConditioningControlPanel.Helpers"
             xmlns:feat="clr-namespace:ConditioningControlPanel.Features"
             xmlns:rows="clr-namespace:ConditioningControlPanel.Controls.Rows"
             xmlns:pv="clr-namespace:ConditioningControlPanel.Controls.Preview"
             rows:RowHue.TintSliders="True">

    <Grid>
        <StackPanel Grid.IsSharedSizeScope="True">
            <!-- HERO. The old Enable card is gone: its checkbox lives in the pill (same name,
                 same handlers, same SessionLock marker). That card carried no description of
                 its own, so the feature's existing blurb becomes the hero ToolTip instead of a
                 newly invented subtitle string. Hero art is static pack-URI art and is
                 therefore exempt from the mod repaint map. -->
            <Border Height="72" CornerRadius="16" Margin="0,0,0,10"
                    Background="{DynamicResource SurfaceBgBrush}"
                    BorderBrush="{StaticResource SectionHueStudioBorderBrush}" BorderThickness="2"
                    ToolTip="{loc:Str tooltip_random_mind_wipe_audio_effects_escalates_in_f}">
                <Grid ClipToBounds="True">
                    <Border Width="240" HorizontalAlignment="Right" CornerRadius="0,16,16,0">
                        <Border.Background>
                            <ImageBrush x:Name="HeroArtBrush" Stretch="UniformToFill" AlignmentX="Right" Opacity="0.9">
                                <ImageBrush.ImageSource>
                                    <BitmapImage UriSource="pack://application:,,,/Resources/features/Mind_Wipers.png"
                                                 DecodePixelWidth="480"/>
                                </ImageBrush.ImageSource>
                            </ImageBrush>
                        </Border.Background>
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#E6000000" Offset="0.55"/>
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                    </Border>

                    <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                        <helpers:EmojiTextBlock Text="{loc:Str label_mind_wipe}" FontSize="17" FontWeight="Bold"
                                                Foreground="{StaticResource TextLightBrush}"/>
                    </StackPanel>

                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                            CornerRadius="9999" Padding="12,6"
                            Background="#8C131320" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Str btn_enable}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <CheckBox x:Name="ChkEnable" feat:SessionLock.Owned="True"
                                      Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                      Checked="ChkEnable_Changed" Unchecked="ChkEnable_Changed"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- VELVET KIT 2 · ROUND 3 · DENSITY. The settings column is capped (3*, MaxWidth 780) so a
                 slider stops being a ~1200px runway in the wide Studio detail pane, and the width that
                 buys back becomes ONE big art card instead of dead margin. Everything below column 0 is
                 the previous page contents moved verbatim - same names, handlers, lock markers and loc
                 keys. Below 700px (the 520px feature popup) the art column collapses to zero and the
                 settings retake the full width: Features/AdaptiveSideArt.cs. -->
            <Grid feat:AdaptiveSideArt.CollapseBelow="700">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MaxWidth="780"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <!-- ONE dense controls card: the two dials, then the loop switch. -->
                    <Border Style="{StaticResource SettingCardStyle}">
                        <Grid>
                            <Border Background="{StaticResource SectionHueStudioWashBrush}" CornerRadius="11"/>
                            <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                                    Background="{StaticResource SectionHueStudioBrush}"/>
                            <StackPanel Margin="16,8,16,8">

                                <!-- Frequency -->
                                <Grid Style="{StaticResource OptionRow}" ToolTip="{loc:Str tooltip_mind_wipe_frequency_1_180_per_hour}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="RowLabel"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" MinWidth="56"/>
                                    </Grid.ColumnDefinitions>
                                    <rows:RowLabel Grid.Column="0" Text="{loc:Str setting_frequency}" Emblem="Often">
                                        <rows:RowLabel.Value>
                                            <MultiBinding Converter="{x:Static rows:RowFraction.Instance}">
                                                <Binding Path="Value" ElementName="SliderFreq"/>
                                                <Binding Path="Maximum" ElementName="SliderFreq"/>
                                            </MultiBinding>
                                        </rows:RowLabel.Value>
                                    </rows:RowLabel>
                                    <Slider Grid.Column="1" x:Name="SliderFreq" Minimum="1" Maximum="180" Value="6"
                                            feat:SessionLock.Owned="True" VerticalAlignment="Center" Margin="10,0"
                                            ValueChanged="SliderFreq_Changed"/>
                                    <rows:RowValue Grid.Column="2" x:Name="TxtFreq" Text="6" Unit="{loc:Str row_unit_an_hour}"/>
                                </Grid>

                                <!-- Volume -->
                                <Grid Style="{StaticResource OptionRow}" ToolTip="{loc:Str tooltip_volume_level_0_100}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="RowLabel"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" MinWidth="56"/>
                                    </Grid.ColumnDefinitions>
                                    <rows:RowLabel Grid.Column="0" Text="{loc:Str setting_volume}" Emblem="Loud"/>
                                    <Slider Grid.Column="1" x:Name="SliderVolume" Minimum="0" Maximum="100" Value="50"
                                            VerticalAlignment="Center" Margin="10,0"
                                            ValueChanged="SliderVolume_Changed"/>
                                    <rows:RowValue Grid.Column="2" x:Name="TxtVolume" Text="50%"/>
                                </Grid>

                                <Border Height="1" Margin="0,6" Background="{DynamicResource GlassBorderBrush}"/>

                                <!-- Loop in background -->
                                <Grid Style="{StaticResource OptionRow}" ToolTip="{loc:Str tooltip_continuously_loop_a_single_track_instead_of_r}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <rows:RowLabel Grid.Column="0" Text="{loc:Str setting_loop_in_background}" Emblem="Loop"
                                                   IsOn="{Binding IsChecked, ElementName=ChkLoop}"/>
                                    <CheckBox Grid.Column="1" x:Name="ChkLoop"
                                              Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                              Checked="ChkLoop_Changed" Unchecked="ChkLoop_Changed"/>
                                </Grid>

                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Custom audio clip: its own card, same grammar. The guidance line that used to
                         sit under the title is the card's ToolTip; TxtAudioFile stays visible because
                         code-behind writes the current filename into it. -->
                    <Border Style="{StaticResource SettingCardStyle}"
                            ToolTip="{loc:Str tooltip_mind_wipe_custom_audio}">
                        <Grid>
                            <Border Background="{StaticResource SectionHueStudioWashBrush}" CornerRadius="11"/>
                            <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                                    Background="{StaticResource SectionHueStudioBrush}"/>
                            <StackPanel Margin="16,8,16,8">
                                <Grid Height="34">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CUSTOM AUDIO" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtAudioFile" Text="{loc:Str label_mind_wipe_audio_default}"
                                               Foreground="{DynamicResource PinkBrush}" FontSize="12"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="10,0,0,0"/>
                                </Grid>
                                <Grid Height="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="BtnSelectAudio" Content="{loc:Str btn_select_audio}"
                                            Style="{DynamicResource OutlineButton}" Padding="12,6"
                                            Margin="0,0,6,0" Click="BtnSelectAudio_Click"/>
                                    <Button Grid.Column="1" x:Name="BtnClearAudio" Content="Reset"
                                            Style="{DynamicResource OutlineButton}" Padding="12,6"
                                            Click="BtnClearAudio_Click"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button Content="{loc:Str btn_test_now_2}" Style="{DynamicResource OutlineButton}"
                            Click="BtnTest_Click"/>
                </StackPanel>

                <!-- SIDE ART -> LIVE PREVIEW (owner 2026-11-24): the card is a framed slice of a desktop where
                     the effect plays with fake content (Controls/Preview/EffectPreview.cs). The mod art brush stays
                     (ApplyFeatureArt writes it) but is parked in Tag, so nothing shows behind the preview; the card
                     keeps its size and its AdaptiveSideArt collapse. -->
                <Border Grid.Column="1" Margin="10,0,0,0" CornerRadius="14"
                        BorderThickness="2" BorderBrush="{StaticResource VelvetCardBorderBrush}"
                        Background="#06050D" VerticalAlignment="Stretch" MinHeight="200">
                    <Border.Tag>
                        <ImageBrush x:Name="SideArtBrush" Stretch="UniformToFill"/>
                    </Border.Tag>
                    <pv:EffectPreview Scene="mindwipe"/>
                </Border>
            </Grid>

        </StackPanel>
    </Grid>
</UserControl>
