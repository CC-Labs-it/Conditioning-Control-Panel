<UserControl x:Class="ConditioningControlPanel.Features.BubbleCountFeatureControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             xmlns:helpers="clr-namespace:ConditioningControlPanel.Helpers"
             xmlns:feat="clr-namespace:ConditioningControlPanel.Features"
             xmlns:rows="clr-namespace:ConditioningControlPanel.Controls.Rows"
             xmlns:pv="clr-namespace:ConditioningControlPanel.Controls.Preview"
             rows:RowHue.TintSliders="True">

    <!-- Velvet Kit 2 density pass. The root IS the StackPanel (the old Grid wrapper is gone):
         MainWindow.SessionFeatureLock.cs inserts the session-lock banner at index 0 of
         content.Content, and into a Grid that banner would have overlapped the settings. -->
    <StackPanel Grid.IsSharedSizeScope="True">

        <!-- HERO. No subtitle line: this module's only description string
             (tooltip_count_the_bubbles_challenge_memory_and_attent) is three lines long and
             would overflow the 72px strip, so it rides the enable pill as a ToolTip instead. -->
        <Border Height="72" CornerRadius="16" Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{StaticResource SectionHueStudioBorderBrush}" BorderThickness="2" Margin="0,0,0,10">
            <Grid>
                <Border CornerRadius="0,16,16,0" Width="240" HorizontalAlignment="Right">
                    <Border.Background>
                        <ImageBrush x:Name="HeroArtBrush" Stretch="UniformToFill" AlignmentX="Right" Opacity="0.9">
                            <ImageBrush.ImageSource>
                                <BitmapImage UriSource="pack://application:,,,/Resources/features/Bubble_count.png" DecodePixelWidth="480"/>
                            </ImageBrush.ImageSource>
                        </ImageBrush>
                    </Border.Background>
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#E6000000" Offset="0.55"/>
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="18,0,0,0">
                    <helpers:EmojiTextBlock Text="{loc:Str label_bubble_count}" FontSize="17" FontWeight="Bold"
                                            Foreground="{StaticResource TextLightBrush}"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" CornerRadius="99"
                        Background="#8C131320" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="12,5,8,5"
                        ToolTip="{loc:Str tooltip_count_the_bubbles_challenge_memory_and_attent}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Str btn_enable}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <CheckBox x:Name="ChkEnable" feat:SessionLock.Owned="True"
                                  Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                  Checked="ChkEnable_Changed" Unchecked="ChkEnable_Changed"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- VELVET KIT 2 · ROUND 3 · DENSITY. The settings column is capped (3*, MaxWidth 780) so a
             slider stops being a ~1200px runway in the wide Studio detail pane, and the width that
             buys back becomes ONE big art card instead of dead margin. Everything below column 0 is
             the previous page contents moved verbatim - same names, handlers, lock markers and loc
             keys. Below 700px (the 520px feature popup) the art column collapses to zero and the
             settings retake the full width: Features/AdaptiveSideArt.cs. -->
        <Grid feat:AdaptiveSideArt.CollapseBelow="700">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MaxWidth="780"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <!-- ONE dense card -->
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid>
                        <Border Background="{StaticResource SectionHueStudioWashBrush}" CornerRadius="11"/>
                        <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                                Background="{StaticResource SectionHueStudioBrush}"/>
                        <StackPanel Margin="16,8,16,8">

                            <Grid Style="{StaticResource OptionRow}" Background="Transparent" ToolTip="{loc:Str tooltip_challenges_per_hour_1_10}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="RowLabel"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" MinWidth="56"/>
                                </Grid.ColumnDefinitions>
                                <rows:RowLabel Grid.Column="0" Text="{loc:Str setting_per_hour}" Emblem="Often">
                                    <rows:RowLabel.Value>
                                        <MultiBinding Converter="{x:Static rows:RowFraction.Instance}">
                                            <Binding Path="Value" ElementName="SliderFreq"/>
                                            <Binding Path="Maximum" ElementName="SliderFreq"/>
                                        </MultiBinding>
                                    </rows:RowLabel.Value>
                                </rows:RowLabel>
                                <Slider Grid.Column="1" x:Name="SliderFreq" Minimum="1" Maximum="10" Value="2"
                                        feat:SessionLock.Owned="True" VerticalAlignment="Center" Margin="14,0"
                                        ValueChanged="SliderFreq_Changed"/>
                                <rows:RowValue Grid.Column="2" x:Name="TxtFreq" Text="2" Unit="{loc:Str row_unit_an_hour}"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource GlassBorderBrush}" Margin="0,6"/>

                            <Grid Style="{StaticResource OptionRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <rows:RowLabel Grid.Column="0" Text="{loc:Str setting_difficulty}" Emblem="Much"/>
                                <ComboBox Grid.Column="1" x:Name="CmbDifficulty" Width="130" feat:SessionLock.Owned="True"
                                          VerticalAlignment="Center"
                                          Style="{DynamicResource RowComboBoxStyle}"
                                          SelectionChanged="CmbDifficulty_Changed">
                                    <ComboBoxItem Content="{loc:Str btn_easy}" Tag="0"/>
                                    <ComboBoxItem Content="{loc:Str btn_medium}" Tag="1" IsSelected="True"/>
                                    <ComboBoxItem Content="{loc:Str btn_hard}" Tag="2"/>
                                </ComboBox>
                            </Grid>

                            <Grid Style="{StaticResource OptionRow}" Background="Transparent" ToolTip="{loc:Str tooltip_prevent_closing_until_correctly_answered}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <rows:RowLabel Grid.Column="0" Text="{loc:Str setting_strict_lock}" Emblem="Lock"
                                               IsOn="{Binding IsChecked, ElementName=ChkStrict}"/>
                                <CheckBox Grid.Column="1" x:Name="ChkStrict"
                                          Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                          Checked="ChkStrict_Changed" Unchecked="ChkStrict_Changed"/>
                            </Grid>

                            <!-- #1418: off by default. On, a round holds flashes, spirals and the
                                 overlays the way a mandatory video does. -->
                            <Grid Style="{StaticResource OptionRow}" Background="Transparent" ToolTip="{loc:Str tooltip_bubble_count_pause_effects}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <rows:RowLabel Grid.Column="0" Text="{loc:Str setting_bubble_count_pause_effects}" Emblem="Reacts"
                                               IsOn="{Binding IsChecked, ElementName=ChkPauseEffects}"/>
                                <CheckBox Grid.Column="1" x:Name="ChkPauseEffects"
                                          Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                          Checked="ChkPauseEffects_Changed" Unchecked="ChkPauseEffects_Changed"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Button Content="{loc:Str btn_test_now}" Style="{DynamicResource OutlineButton}"
                        Click="BtnTest_Click"/>
            </StackPanel>

            <!-- SIDE ART -> LIVE PREVIEW (sweep lane P2, owner 2026-11-24): the card is a framed slice of a desktop
                 where Bubble Count plays with fake content (Controls/Preview/EffectPreview.cs). The mod art brush
                 stays (ApplyFeatureArt writes it) but is parked in Tag, so nothing shows behind the preview;
                 the card keeps its size and its AdaptiveSideArt collapse. -->
            <Border Grid.Column="1" Margin="10,0,0,0" CornerRadius="14"
                    BorderThickness="2" BorderBrush="{StaticResource VelvetCardBorderBrush}"
                    Background="#06050D" VerticalAlignment="Stretch" MinHeight="200">
                <Border.Tag>
                    <ImageBrush x:Name="SideArtBrush" Stretch="UniformToFill"/>
                </Border.Tag>
                <pv:EffectPreview Scene="bubblecount"/>
            </Border>
        </Grid>

    </StackPanel>
</UserControl>
