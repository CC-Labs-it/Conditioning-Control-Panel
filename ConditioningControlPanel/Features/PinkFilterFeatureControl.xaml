<UserControl x:Class="ConditioningControlPanel.Features.PinkFilterFeatureControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ConditioningControlPanel.Controls"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             xmlns:helpers="clr-namespace:ConditioningControlPanel.Helpers"
             xmlns:feat="clr-namespace:ConditioningControlPanel.Features">

    <!-- Velvet Kit 2 density pass. The root IS the StackPanel (the old Grid wrapper is gone):
         MainWindow.SessionFeatureLock.cs inserts the session-lock banner at index 0 of
         content.Content, and into a Grid that banner would have overlapped the settings. -->
    <StackPanel>

        <!-- HERO -->
        <Border Height="72" CornerRadius="16" Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{StaticResource SectionHueStudioBorderBrush}" BorderThickness="2" Margin="0,0,0,10">
            <Grid>
                <Border CornerRadius="0,16,16,0" Width="240" HorizontalAlignment="Right">
                    <Border.Background>
                        <ImageBrush x:Name="HeroArtBrush" Stretch="UniformToFill" AlignmentX="Right" Opacity="0.9">
                            <ImageBrush.ImageSource>
                                <BitmapImage UriSource="pack://application:,,,/Resources/features/Pink_filter.png" DecodePixelWidth="480"/>
                            </ImageBrush.ImageSource>
                        </ImageBrush>
                    </Border.Background>
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#E6000000" Offset="0.55"/>
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="18,0,0,0">
                    <helpers:EmojiTextBlock Text="{loc:Str label_pink_filter}" FontSize="17" FontWeight="Bold"
                                            Foreground="{StaticResource TextLightBrush}"/>
                    <TextBlock Text="{loc:Str tooltip_apply_pink_color_filter_to_all_monitors}" FontSize="11.5"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" CornerRadius="99"
                        Background="#8C131320" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="12,5,8,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Str btn_enable}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <CheckBox x:Name="ChkEnable"
                                  feat:SessionLock.Owned="True"
                                  Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                  Checked="ChkEnable_Changed" Unchecked="ChkEnable_Changed"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- VELVET KIT 2 · ROUND 3 · DENSITY. The settings column is capped (3*, MaxWidth 780) so a
             slider stops being a ~1200px runway in the wide Studio detail pane, and the width that
             buys back becomes ONE big art card instead of dead margin. Everything below column 0 is
             the previous page contents moved verbatim - same names, handlers, lock markers and loc
             keys. Below 700px (the 520px feature popup) the art column collapses to zero and the
             settings retake the full width: Features/AdaptiveSideArt.cs. -->
        <Grid feat:AdaptiveSideArt.CollapseBelow="700">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MaxWidth="780"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <!-- ONE dense card: opacity, colour, and the monitor picker (#639). -->
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid>
                        <Border Background="{StaticResource SectionHueStudioWashBrush}" CornerRadius="11"/>
                        <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                                Background="{StaticResource SectionHueStudioBrush}"/>
                        <StackPanel Margin="16,8,16,8">

                            <feat:OptionSection Key="pinkfilter.basics" Title="{loc:Str studio_section_basics}" Theme="Main">
                            <Grid Height="36" Background="Transparent" ToolTip="{loc:Str tooltip_filter_opacity_5_50}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" MinWidth="56"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Str setting_opacity}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="SliderOpacity" feat:OptionSection.Setting="PinkFilterOpacity" Minimum="5" Maximum="50" Value="10"
                                        feat:SessionLock.Owned="True" VerticalAlignment="Center" Margin="14,0"
                                        ValueChanged="SliderOpacity_Changed"/>
                                <TextBlock Grid.Column="2" x:Name="TxtOpacity" Text="10%" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Foreground="{DynamicResource PinkBrush}"
                                           FontSize="13" FontWeight="Bold"/>
                            </Grid>
                            </feat:OptionSection>

                            <feat:OptionSection Key="pinkfilter.look" Title="{loc:Str studio_section_look}" Theme="Look">
                            <Grid Height="40" Background="Transparent" ToolTip="{loc:Str tooltip_pink_filter_color}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Str setting_filter_color}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="ColorSwatch" Width="26" Height="26" CornerRadius="8"
                                            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                            Background="#FF69B4" Margin="0,0,8,0"/>
                                    <Button x:Name="BtnChooseColor" Content="{loc:Str btn_choose_color}"
                                            Style="{StaticResource SmallPinkButton}" Click="BtnChooseColor_Click"/>
                                    <Button x:Name="BtnResetColor" Content="{loc:Str btn_reset}"
                                            Style="{StaticResource SmallPinkButton}" Click="BtnResetColor_Click"
                                            Margin="6,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Two-tone fog beside the colour it mixes with (pink filter and Steam both wear it):
                                 the switch and the second colour when owned, a locked chip to the shop when not. -->
                            <ctl:FogTwoToneBlock x:Name="FogTwoTone"/>
                            </feat:OptionSection>

                            <feat:OptionSection Key="pinkfilter.extras" Title="{loc:Str studio_section_extras}" Theme="Advanced" DefaultOpen="False">
                            <Grid Height="36" Background="Transparent" ToolTip="{loc:Str tooltip_effect_monitor}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Str setting_effect_monitor}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" x:Name="CmbMonitor" feat:OptionSection.Setting="PinkFilterTargetMonitor"
                                          Width="180" VerticalAlignment="Center"
                                          Style="{DynamicResource DarkComboBoxStyle}"
                                          DropDownOpened="CmbMonitor_DropDownOpened"
                                          SelectionChanged="CmbMonitor_Changed"/>
                            </Grid>

                            <!-- #1546: tint under spirals, subliminals, bubbles and text instead of over them. -->
                            <Grid Height="36" Background="Transparent" ToolTip="{loc:Str tooltip_pink_filter_under_effects}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Str setting_pink_filter_under_effects}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" x:Name="ChkUnderEffects"
                                          Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                          Checked="ChkUnderEffects_Changed" Unchecked="ChkUnderEffects_Changed"/>
                            </Grid>
                            </feat:OptionSection>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- The gold V2 box (Controls/SuperBox): Super switch, BASIC sign, weekly try.
                     Steam's options sit in it, shown while Steam is picked
                     (Features/PinkFilterFeatureControl.Creep.cs). Opacity, colour, monitor and the
                     under-effects switch above all still drive Steam, so none of them is repeated. -->
                <ctl:SuperBox x:Name="SuperBoxMain" Effect="Creep">
                  <StackPanel x:Name="SteamRows" Visibility="Collapsed">
                    <Border Height="1" Background="#33FFE08A" Margin="0,2,0,6"/>
                    <!-- Steam: the words in the fog. -->
                    <Grid x:Name="SteamWordsRow" Height="36" Background="Transparent"
                          ToolTip="{loc:Str tooltip_super_steam_words}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Str super_steam_words}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1" x:Name="ChkSteamWords"
                                  Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                  Checked="ChkSteamWords_Changed" Unchecked="ChkSteamWords_Changed"/>
                    </Grid>
                    <!-- Steam: how fast the fog creeps in (the October Creep speed setting, Normal = 4 minutes). -->
                    <Grid x:Name="SteamCreepRow" Height="36" Background="Transparent"
                          ToolTip="{loc:Str tooltip_super_steam_creep}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Str super_steam_creep}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="CmbCreepSpeed" feat:OptionSection.Setting="SuperCreepSpeed" Width="180" VerticalAlignment="Center"
                                  Style="{DynamicResource DarkComboBoxStyle}"
                                  SelectionChanged="CmbCreepSpeed_Changed"/>
                    </Grid>
                    <!-- Steam: the size of the spot around the cursor that moves the fog. -->
                    <Grid x:Name="SteamSizeRow" Height="36" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" MinWidth="56"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Str super_steam_size}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="SliderSteamSize" feat:OptionSection.Setting="SteamWipeSize" Minimum="40" Maximum="300" Value="100"
                                VerticalAlignment="Center" Margin="14,0" ValueChanged="SliderSteamSize_Changed"/>
                        <TextBlock Grid.Column="2" x:Name="TxtSteamSize" Text="100%" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PinkBrush}"
                                   FontSize="13" FontWeight="Bold"/>
                    </Grid>
                    <!-- Steam: how fast the fog closes back over a wipe (CCP.Core/Super/SteamOptions). -->
                    <Grid x:Name="SteamReturnRow" Height="36" Background="Transparent"
                          ToolTip="{loc:Str tooltip_super_steam_return}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" MinWidth="56"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Str super_steam_return}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="SliderSteamReturn" feat:OptionSection.Setting="SteamFogReturn" Minimum="25" Maximum="300" Value="100"
                                VerticalAlignment="Center" Margin="14,0" ValueChanged="SliderSteamReturn_Changed"/>
                        <TextBlock Grid.Column="2" x:Name="TxtSteamReturn" Text="100%" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PinkBrush}"
                                   FontSize="13" FontWeight="Bold"/>
                    </Grid>
                    <!-- Steam: how much the fog billows on its own (0 = still). -->
                    <Grid x:Name="SteamDriftRow" Height="36" Background="Transparent"
                          ToolTip="{loc:Str tooltip_super_steam_drift}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" MinWidth="56"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Str super_steam_drift}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="SliderSteamDrift" feat:OptionSection.Setting="SteamDrift" Minimum="0" Maximum="200" Value="100"
                                VerticalAlignment="Center" Margin="14,0" ValueChanged="SliderSteamDrift_Changed"/>
                        <TextBlock Grid.Column="2" x:Name="TxtSteamDrift" Text="100%" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PinkBrush}"
                                   FontSize="13" FontWeight="Bold"/>
                    </Grid>
                    <!-- The October Creep's fog cap. Steam does not read it (the pink filter's
                         opacity sets how thick the fog draws), so it stays folded. -->
                    <Border x:Name="CreepCard" Visibility="Collapsed"
                            Loaded="CreepCard_Loaded" Unloaded="CreepCard_Unloaded">
                        <StackPanel Margin="0,6,0,0">
                            <Grid Height="36" Background="Transparent" ToolTip="{loc:Str tooltip_super_creep_cap}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" MinWidth="56"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Str super_creep_cap}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="SliderCreepCap" feat:OptionSection.Setting="SuperCreepCap" Minimum="20" Maximum="90" Value="90"
                                        VerticalAlignment="Center" Margin="14,0" ValueChanged="SliderCreepCap_Changed"/>
                                <TextBlock Grid.Column="2" x:Name="TxtCreepCap" Text="90%" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Foreground="{DynamicResource PinkBrush}"
                                           FontSize="13" FontWeight="Bold"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                  </StackPanel>
                </ctl:SuperBox>
            </StackPanel>

            <!-- SIDE ART. The art is the Border's BACKGROUND, not a child Image: a Border clips its
                 Background to CornerRadius but does NOT clip child content, so a child Image would
                 square off the rounded corners (round-2 lesson). Same plate the hero uses. -->
            <Border Grid.Column="1" Margin="10,0,0,0" CornerRadius="14"
                    BorderThickness="2" BorderBrush="{StaticResource VelvetCardBorderBrush}"
                    VerticalAlignment="Stretch" MinHeight="200">
                <Border.Background>
                    <ImageBrush x:Name="SideArtBrush" Stretch="UniformToFill">
                        <ImageBrush.ImageSource>
                            <BitmapImage UriSource="pack://application:,,,/Resources/features/Pink_filter.png"
                                         DecodePixelWidth="800"/>
                        </ImageBrush.ImageSource>
                    </ImageBrush>
                </Border.Background>
                <!-- Scrim so the plate sits under the page instead of fighting it. -->
                <Border CornerRadius="12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Color="#66000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="0.45"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Border>
        </Grid>

    </StackPanel>
</UserControl>
