<Window x:Class="ConditioningControlPanel.AssetsNudgeCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
        Title="Getting pictures in"
        Width="400" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- The assets nudge (2026-11-25): three small cards, each with a moving arrow pointing at the
         real control (Library source bar, the Folders zone, the Start button). Same glass as
         StartHereCard. Non-modal and never activated, so the app under it keeps working. -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Arrow above the card (points UP at a target above) -->
        <Path x:Name="ArrowUp" Grid.Row="0" Height="26" Width="26" Stretch="Uniform" Margin="0,0,0,-4"
              HorizontalAlignment="Left" Fill="{DynamicResource PinkBrush}" Visibility="Collapsed"
              Data="M 12,0 L 24,14 L 16,14 L 16,24 L 8,24 L 8,14 L 0,14 Z">
            <Path.RenderTransform><TranslateTransform x:Name="ArrowUpShift"/></Path.RenderTransform>
        </Path>

        <Border x:Name="CardRoot" Grid.Row="1" CornerRadius="14" BorderThickness="1" Margin="4"
                BorderBrush="{DynamicResource PinkBrush}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                    <GradientStop Color="#FF2C1450" Offset="0"/>
                    <GradientStop Color="#FF1C1233" Offset="0.45"/>
                    <GradientStop Color="#FF100A1E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="3" Opacity="0.6"/>
            </Border.Effect>

            <StackPanel Margin="18,14,18,14">
                <Grid>
                    <TextBlock x:Name="TxtTitle" FontSize="16" FontWeight="ExtraBold"
                               Foreground="{DynamicResource PinkBrush}"/>
                    <TextBlock x:Name="TxtCount" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="11" Foreground="#99FFFFFF"/>
                </Grid>
                <TextBlock x:Name="TxtBody" Margin="0,6,0,12" FontSize="13" Foreground="#E6FFFFFF"
                           TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnSkip" Content="{loc:Str assetsnudge_skip}" Click="BtnSkip_Click"
                            Style="{StaticResource SecondaryButton}" Padding="14,5" FontSize="12"/>
                    <Button x:Name="BtnNext" Click="BtnNext_Click" Margin="8,0,0,0"
                            Style="{StaticResource PinkButton}" Padding="16,5" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Arrow below the card (points DOWN at a target below) -->
        <Path x:Name="ArrowDown" Grid.Row="2" Height="26" Width="26" Stretch="Uniform" Margin="0,-4,0,0"
              HorizontalAlignment="Left" Fill="{DynamicResource PinkBrush}" Visibility="Collapsed"
              Data="M 8,0 L 16,0 L 16,10 L 24,10 L 12,24 L 0,10 L 8,10 Z">
            <Path.RenderTransform><TranslateTransform x:Name="ArrowDownShift"/></Path.RenderTransform>
        </Path>
    </Grid>
</Window>
