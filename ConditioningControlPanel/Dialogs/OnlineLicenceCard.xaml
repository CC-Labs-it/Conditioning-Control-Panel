<Window x:Class="ConditioningControlPanel.OnlineLicenceCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
        Title="{loc:Str online_official_title}"
        Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#181830"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        AllowsTransparency="False">

    <!-- The licence card (owner, 2026-10-21): the one-time pop-up that says online media is going
         official and why there is a daily share. Same gate as the Assets tab's note
         (OnlineMeterRules.ShowOfficialNote); "Nice" marks both seen. Copy only, no motion. -->
    <Border BorderBrush="#3A3A5C" BorderThickness="1">
        <StackPanel Margin="24,20,24,18">
            <DockPanel Margin="0,0,0,10">
                <Border DockPanel.Dock="Right" VerticalAlignment="Top" BorderBrush="{DynamicResource PinkBrush}"
                        BorderThickness="2" CornerRadius="4" Padding="7,2,7,1" Margin="14,2,0,0">
                    <Border.LayoutTransform>
                        <RotateTransform Angle="-3"/>
                    </Border.LayoutTransform>
                    <TextBlock Text="{loc:Str online_official_stamp}" FontSize="10" FontWeight="ExtraBold"
                               Foreground="{DynamicResource PinkBrush}"/>
                </Border>
                <TextBlock Text="{loc:Str online_official_title}" FontSize="19" FontWeight="SemiBold"
                           Foreground="#F0F0F5" TextWrapping="Wrap"/>
            </DockPanel>

            <TextBlock Text="{loc:Str online_official_body}" FontSize="13" Foreground="#CCCCE0" TextWrapping="Wrap"/>

            <TextBlock Text="{loc:Str online_official_why_title}" Margin="0,16,0,5" FontSize="11.5" FontWeight="Bold"
                       Foreground="{DynamicResource PinkBrush}"/>
            <TextBlock Text="{loc:Str online_official_why}" FontSize="13" Foreground="#CCCCE0" TextWrapping="Wrap"/>

            <TextBlock Text="{loc:Str online_official_flow_title}" Margin="0,16,0,5" FontSize="11.5" FontWeight="Bold"
                       Foreground="{DynamicResource PinkBrush}"/>
            <ItemsControl x:Name="FlowLines" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource PinkBrush}"
                                     VerticalAlignment="Top" HorizontalAlignment="Left" Margin="1,6,0,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12.5" Foreground="#A7A7C1"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Margin="0,10,0,0" BorderBrush="#2E2E4A" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                <TextBlock x:Name="TxtPlan" FontSize="12.5" Foreground="#E0B0FF" TextWrapping="Wrap"/>
            </Border>

            <Button x:Name="BtnNice" Content="{loc:Str online_official_nice}" Style="{StaticResource SmallPinkButton}"
                    HorizontalAlignment="Right" Padding="22,7" FontSize="13" Margin="0,14,0,0"
                    IsDefault="True" Click="BtnNice_Click"/>
        </StackPanel>
    </Border>
</Window>
