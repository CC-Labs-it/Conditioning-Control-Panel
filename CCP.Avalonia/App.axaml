<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ConditioningControlPanel.Avalonia.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- The app's real palette, ported key-for-key from the WPF head so the two can be
             compared side by side. Colors first, then the brushes derived from them - the
             same merge order App.xaml uses. -->
        <ResourceInclude Source="avares://CCP.Avalonia/Theme/Colors.xaml"/>
        <ResourceInclude Source="avares://CCP.Avalonia/Theme/Brushes.xaml"/>
        <!-- The depth pass brushes (WPF App.xaml merges Depth.xaml beside Brushes.xaml). -->
        <ResourceInclude Source="avares://CCP.Avalonia/Theme/Depth.xaml"/>
        <!-- Keyed styles the views are written against, as ControlThemes. -->
        <ResourceInclude Source="avares://CCP.Avalonia/Theme/Styles.xaml"/>
        <!-- The Workshop cells' interior typography. Kept beside the cells rather than folded
             into Styles.xaml, matching the WPF head where all six Workshop*Cell views merge
             this same dictionary. Merged once here so every cell resolves the keys without
             each repeating a ResourceInclude. -->
        <ResourceInclude Source="avares://CCP.Avalonia/Views/Controls/Companion/Runtime/WorkshopCellTheme.axaml"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- WPF App.xaml: one shared monospace chain for DynamicResource consumers. -->
      <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
      <!-- WPF's default text size is SystemFonts.MessageFontSize: 9pt Segoe UI = 12px, inherited
           from every Window. Fluent's Window, Button, CheckBox, ComboBox, TextBox, RadioButton and
           friends all read this key (default 14), so unsized controls and text drew 2px larger. -->
      <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://CCP.Avalonia/Theme/InputMenus.axaml"/>
    <!-- WPF Inputs.xaml implicit chrome; local/keyed themes retain precedence. -->
    <Style Selector="TextBox">
      <Setter Property="Theme" Value="{StaticResource InputTextBoxTheme}"/>
    </Style>
    <!-- Keyed TextBox themes BasedOn Fluent's (BugReport FormBox, ModCreator, Deeper editor, ...) port
         WPF styles that sit on the stock Aero2 template, which never repaints the box on hover or
         focus. Fluent swaps in a black focused fill and a 2px border; keep the box's own fill and
         border width for every TextBox (a Style outranks any ControlTheme). -->
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
    </Style>
    <Style Selector="TextBox:focus-within /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
      <Setter Property="BorderThickness" Value="{Binding BorderThickness, RelativeSource={RelativeSource TemplatedParent}}"/>
    </Style>
    <!-- Inputs.xaml:218 and 394. Local Theme and ItemContainerTheme still win. -->
    <Style Selector="CheckBox">
      <Setter Property="Theme" Value="{StaticResource InputCheckBoxTheme}"/>
    </Style>
    <Style Selector="ListBox">
      <Setter Property="ItemContainerTheme" Value="{StaticResource InputListBoxItemTheme}"/>
    </Style>
    <!-- Inputs.xaml:42 implicit ComboBox (and its ComboBoxItem rows). Local Theme still wins. -->
    <Style Selector="ComboBox">
      <Setter Property="Theme" Value="{StaticResource InputComboBoxTheme}"/>
    </Style>
    <!-- Icon size ramp + semantic icon brushes (Controls/Icons, fluent icons 2026-10-10). -->
    <StyleInclude Source="avares://CCP.Avalonia/Theme/Icons.axaml"/>
    <!-- WPF MainWindow.xaml:457: scrollbar occupies its own row/column. -->
    <Style Selector="ScrollViewer"><Setter Property="AllowAutoHide" Value="False"/></Style>
  </Application.Styles>
</Application>
