<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ConditioningControlPanel.Avalonia.Localization"
        xmlns:fx="clr-namespace:ConditioningControlPanel.Avalonia.Controls"
        x:Class="ConditioningControlPanel.Avalonia.Views.Dialogs.DeleteDialogWindow"
        Width="470" Height="300" CanResize="False" SystemDecorations="None"
        ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="CenterOwner" Background="#1A0A0A">
  <Border BorderBrush="#DC143C" BorderThickness="2">
    <Grid RowDefinitions="Auto,*">
      <Border Background="#DC143C" Padding="10,5"><TextBlock x:Name="Caption" Foreground="White" FontWeight="SemiBold"/></Border>
      <Grid Grid.Row="1" Margin="14,12" ColumnDefinitions="Auto,*">
        <Grid Width="82" Height="120" VerticalAlignment="Top">
          <Image x:Name="Portrait" Width="82" Height="120" Stretch="Uniform" IsHitTestVisible="False"/>
          <fx:IconGlyph x:Name="Fallback" Kind="Delete" Size="48" Foreground="#DC143C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
      <StackPanel Grid.Column="1" Margin="12,0,0,0">
        <TextBlock Text="{loc:Str possession_delete_heading}" Foreground="#FFE3DA" FontSize="14" FontWeight="SemiBold"/>
        <StackPanel x:Name="Names" Margin="0,6,0,8"/>
        <TextBlock x:Name="Status" Foreground="#C09A92" FontSize="12" Margin="0,2,0,8"/>
        <ProgressBar x:Name="Progress" Width="300" Height="10" HorizontalAlignment="Left" Minimum="0" Maximum="100" Foreground="#DC143C"/>
        <Button x:Name="Cancel" HorizontalAlignment="Right" Width="90" Margin="0,14,0,0"><TextBlock Text="{loc:Str possession_delete_cancel}"/></Button>
      </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
