<!-- PORTED from ConditioningControlPanel/Views/Controls/AppSettings/MonitorsSettingsSection.xaml
     (nav rework 2026-10-06: c946fdb1f, 2e0b98278, 5a3123f71). The one home of the content monitor
     picker and the four video rows the retired Home System popup held. Same settings keys, same
     write-then-save idiom. Style -> Theme, ToolTip -> ToolTip.Tip, as in the sibling sections. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Avalonia.Localization"
             xmlns:feat="clr-namespace:ConditioningControlPanel.Avalonia.Views.Features"
             x:Class="ConditioningControlPanel.Avalonia.Views.Controls.AppSettings.MonitorsSettingsSection">
    <StackPanel>
        <TextBlock Text="{loc:Str settings_section_monitors}" Theme="{StaticResource SectionHeader}"/>

        <Border Theme="{StaticResource SectionPanel}" Padding="0" Margin="0,0,0,10"
                BorderBrush="{StaticResource SectionHueDevicesBorderBrush}">
            <Grid>
                <Border CornerRadius="11" Background="{StaticResource SectionHueDevicesWashBrush}"/>
                <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                        Background="{StaticResource SectionHueDevicesBrush}"/>
                <StackPanel Margin="15,12,15,12">

                    <feat:MonitorTargetPicker x:Name="ContentMonitorPicker"/>

                    <!-- Depends on the picker, so it stays indented. -->
                    <Grid MinHeight="34" Margin="16,0,0,0" ColumnDefinitions="*,Auto" ToolTip.Tip="{loc:Str tooltip_fill_all_monitors_video}">
                        <TextBlock Theme="{StaticResource SettingLabel}" Text="{loc:Str setting_fill_all_monitors_video}"
                                   Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                        <CheckBox Grid.Column="1" x:Name="ChkFillAllMon" Theme="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid MinHeight="34" ColumnDefinitions="*,Auto" ToolTip.Tip="{loc:Str tooltip_force_video_gpu_decode}">
                        <TextBlock Theme="{StaticResource SettingLabel}" Text="{loc:Str setting_force_video_gpu_decode}"
                                   Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                        <CheckBox Grid.Column="1" x:Name="ChkVideoGpuDecode" Theme="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid MinHeight="34" ColumnDefinitions="*,Auto" ToolTip.Tip="{loc:Str tooltip_blurred_video_background}">
                        <TextBlock Theme="{StaticResource SettingLabel}" Text="{loc:Str setting_blurred_video_background}"
                                   Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                        <CheckBox Grid.Column="1" x:Name="ChkVideoBlurBg" Theme="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid MinHeight="34" ColumnDefinitions="*,Auto" ToolTip.Tip="{loc:Str tooltip_browser_video_engine}">
                        <TextBlock Theme="{StaticResource SettingLabel}" Text="{loc:Str setting_browser_video_engine}"
                                   Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                        <CheckBox Grid.Column="1" x:Name="ChkBrowserVideoEngine" Theme="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                    </Grid>

                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
