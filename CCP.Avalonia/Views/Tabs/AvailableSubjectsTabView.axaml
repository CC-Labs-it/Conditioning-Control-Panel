<!-- WPF AvailableSubjectsTabView is the Lobby now. Ported frame and responsive columns;
     polling, Chess/Goon host doors and row joins remain the named b-lane. -->
<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:fx="clr-namespace:ConditioningControlPanel.Avalonia.Controls"
 xmlns:loc="clr-namespace:ConditioningControlPanel.Avalonia.Localization"
 xmlns:tabs="clr-namespace:ConditioningControlPanel.Avalonia.Views.Tabs"
 x:Class="ConditioningControlPanel.Avalonia.Views.Tabs.AvailableSubjectsTabView">
 <UserControl.Resources>
  <ControlTheme x:Key="LobbyPill" TargetType="Button">
   <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#18FFFFFF"/>
   <Setter Property="BorderBrush" Value="#33FFFFFF"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="18"/><Setter Property="FontFamily" Value="Fredoka, Segoe UI"/>
   <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="0,0,10,8"/>
   <Setter Property="Cursor" Value="Hand"/>
   <!-- A property-only Button ControlTheme has no Template and draws nothing (CLAUDE.md trap 4). -->
   <Setter Property="Template">
    <ControlTemplate TargetType="Button">
     <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
      <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                        Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
    </ControlTemplate>
   </Setter>
   <Style Selector="^:pointerover /template/ Border#bd"><Setter Property="Background" Value="#28FFFFFF"/></Style>
   <Style Selector="^:pressed /template/ Border#bd"><Setter Property="Opacity" Value="0.8"/></Style>
   <Style Selector="^:disabled /template/ Border#bd"><Setter Property="Opacity" Value="0.45"/></Style>
  </ControlTheme>
  <ControlTheme x:Key="LobbyColumn" TargetType="Border">
   <Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="12,12,6,8"/>
   <Setter Property="Background" Value="{DynamicResource DepthWellFloorBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource DepthPressedBevel}"/><Setter Property="BorderThickness" Value="1"/>
  </ControlTheme>
  <ControlTheme x:Key="LobbyHead" TargetType="TextBlock">
   <Setter Property="FontFamily" Value="Fredoka, Segoe UI"/><Setter Property="FontSize" Value="16"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </ControlTheme>
  <ControlTheme x:Key="LobbyCount" TargetType="TextBlock">
   <Setter Property="FontFamily" Value="Fredoka, Segoe UI"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#2A0618"/>
  </ControlTheme>
  <ControlTheme x:Key="LobbyColumnEmpty" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="FontSize" Value="12.5"/>
   <Setter Property="Margin" Value="4,6,6,0"/><Setter Property="TextWrapping" Value="Wrap"/>
  </ControlTheme>
  <DataTemplate x:Key="LobbyRowTemplate" x:DataType="tabs:LobbyCardView">
   <Border Margin="0,0,6,8" CornerRadius="14" Padding="10,9" Background="#14FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1">
    <Grid ColumnDefinitions="*,Auto">
     <StackPanel>
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextLightBrush}" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
       <Ellipse Width="7" Height="7" Margin="7,1,0,0" VerticalAlignment="Center" Fill="#5FFFD0" IsVisible="{Binding Friend}" ToolTip.Tip="{loc:Str lobby_friend_tip}"/>
      </StackPanel>
      <TextBlock Text="{Binding Line}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" MaxLines="1" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
     <!-- ponytail: the row's game/claim door is not wired in this slice. -->
     <Button Grid.Column="1" IsEnabled="False" IsVisible="{Binding HasButton}" Opacity="{Binding ButtonOpacity}" MinWidth="64" Margin="8,0,0,0" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="4"><fx:IconGlyph Kind="LockClosed" Size="12" IsVisible="{Binding Locked}"/><TextBlock Text="{Binding ButtonText}"/></StackPanel>
     </Button>
    </Grid>
   </Border>
  </DataTemplate>
 </UserControl.Resources>
 <Grid>
  <Border IsHitTestVisible="False"><Border.Background><RadialGradientBrush GradientOrigin="28%,10%" Center="28%,10%" RadiusX="90%" RadiusY="90%"><GradientStop Color="#552C1450" Offset="0"/><GradientStop Color="#00100A1E" Offset="1"/></RadialGradientBrush></Border.Background></Border>
  <Border IsHitTestVisible="False" Opacity="0.30"><Border.Background><RadialGradientBrush GradientOrigin="82%,15%" Center="82%,15%" RadiusX="50%" RadiusY="50%"><GradientStop Color="{DynamicResource FxGlowColor}" Offset="0"/><GradientStop Color="#00000000" Offset="1"/></RadialGradientBrush></Border.Background></Border>
  <Border IsHitTestVisible="False" Opacity="0.18"><Border.Background><RadialGradientBrush GradientOrigin="12%,90%" Center="12%,90%" RadiusX="45%" RadiusY="45%"><GradientStop Color="{DynamicResource FxParticleColor}" Offset="0"/><GradientStop Color="#00000000" Offset="1"/></RadialGradientBrush></Border.Background></Border>
  <fx:AmbientFxCanvas x:Name="SubjectsAmbientFx"/>
  <Grid Margin="32,26,32,22" RowDefinitions="Auto,Auto,Auto,*">
   <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
    <TextBlock Theme="{StaticResource Type.PageTitle}" Text="{loc:Str tab_available_subjects}"/>
    <TextBlock x:Name="TxtLobbyCount" Text="{loc:Str desc_available_subjects}" Foreground="{DynamicResource PinkSoftBrush}" FontFamily="Fredoka, Segoe UI" FontSize="16" Margin="14,0,0,5" VerticalAlignment="Bottom"/>
   </StackPanel>
   <StackPanel Grid.Row="1">
    <WrapPanel>
     <Button x:Name="BtnHostChess" Theme="{StaticResource LobbyPill}" IsEnabled="False"><TextBlock Text="{loc:Str lobby_host_chess}"/></Button>
     <Button x:Name="BtnHostGoon" Theme="{StaticResource LobbyPill}" IsEnabled="False"><TextBlock Text="{loc:Str lobby_host_goon}"/></Button>
     <Button x:Name="BtnBecomeASubject" Theme="{StaticResource LobbyPill}" Click="BtnBecomeASubject_Click" ToolTip.Tip="{loc:Str desc_optin_directory_consent}">
      <StackPanel Orientation="Horizontal" Spacing="6"><fx:IconGlyph x:Name="RemoteHostLock" Kind="LockClosed" Size="13"/><TextBlock Text="{loc:Str lobby_host_remote}"/></StackPanel>
     </Button>
    </WrapPanel>
    <TextBlock x:Name="TxtBecomeASubjectSubtitle" Text="{loc:Str desc_become_a_subject_locked}" Foreground="{DynamicResource TextDimBrush}" FontSize="11" Margin="4,0,0,4" IsVisible="False"/>
    <Border x:Name="AvailableSubjectsErrorPanel" IsVisible="False" Margin="0,6,0,0" Padding="14,8" CornerRadius="12" Background="#14FFFFFF" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1">
     <TextBlock Text="{loc:Str lobby_error}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
    </Border>
   </StackPanel>
   <StackPanel x:Name="LobbyTabStrip" Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0" IsVisible="False">
    <Button x:Name="TabOpen" Theme="{StaticResource LobbyPill}" Tag="0" Click="LobbyTab_Click"/>
    <Button x:Name="TabPlaying" Theme="{StaticResource LobbyPill}" Tag="1" Click="LobbyTab_Click"/>
    <Button x:Name="TabFriends" Theme="{StaticResource LobbyPill}" Tag="2" Click="LobbyTab_Click"/>
   </StackPanel>
   <Grid x:Name="LobbyColumns" Grid.Row="3" Margin="0,10,0,0" ColumnDefinitions="*,*,*">
    <Border x:Name="LobbyOpenColumn" Grid.Column="0" Theme="{StaticResource LobbyColumn}">
     <DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,10">
       <TextBlock Text="{loc:Str lobby_list_open}" Theme="{StaticResource LobbyHead}"/>
       <Border CornerRadius="10" Background="#FF5FA2" Padding="8,1,8,2" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="LobbyOpenCount" Text="0" Theme="{StaticResource LobbyCount}"/></Border>
      </StackPanel>
      <Border x:Name="AvailableSubjectsEmptyPanel" DockPanel.Dock="Top">
       <StackPanel><TextBlock x:Name="TxtLobbyEmpty" Text="{loc:Str lobby_empty_open}" Theme="{StaticResource LobbyColumnEmpty}"/>
        <WrapPanel HorizontalAlignment="Center" Margin="0,8,0,4">
         <Button x:Name="BtnEmptyHostChess" Theme="{StaticResource LobbyPill}" IsEnabled="False"><TextBlock Text="{loc:Str lobby_host_chess}"/></Button>
         <Button x:Name="BtnEmptyHostGoon" Theme="{StaticResource LobbyPill}" IsEnabled="False"><TextBlock Text="{loc:Str lobby_host_goon}"/></Button>
        </WrapPanel>
       </StackPanel>
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="AvailableSubjectsList" ItemTemplate="{StaticResource LobbyRowTemplate}"/></ScrollViewer>
     </DockPanel>
    </Border>
    <Border x:Name="LobbyPlayingSection" Grid.Column="1" Theme="{StaticResource LobbyColumn}">
     <DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,10">
       <TextBlock Text="{loc:Str lobby_list_playing}" Theme="{StaticResource LobbyHead}"/>
       <Border CornerRadius="10" Background="#B99CFF" Padding="8,1,8,2" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="LobbyPlayingCount" Text="0" Theme="{StaticResource LobbyCount}"/></Border>
      </StackPanel>
      <TextBlock x:Name="LobbyPlayingEmpty" DockPanel.Dock="Top" Text="{loc:Str lobby_empty_playing}" Theme="{StaticResource LobbyColumnEmpty}"/>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="LobbyPlayingList" ItemTemplate="{StaticResource LobbyRowTemplate}"/></ScrollViewer>
     </DockPanel>
    </Border>
    <Border x:Name="LobbyFriendsSection" Grid.Column="2" Theme="{StaticResource LobbyColumn}">
     <DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,10">
       <TextBlock Text="{loc:Str lobby_list_friends}" Theme="{StaticResource LobbyHead}"/>
       <Border CornerRadius="10" Background="#5FFFD0" Padding="8,1,8,2" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="LobbyFriendsCount" Text="0" Theme="{StaticResource LobbyCount}"/></Border>
      </StackPanel>
      <TextBlock x:Name="LobbyFriendsEmpty" DockPanel.Dock="Top" Text="{loc:Str lobby_empty_friends}" Theme="{StaticResource LobbyColumnEmpty}"/>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="LobbyFriendsList" ItemTemplate="{StaticResource LobbyRowTemplate}"/></ScrollViewer>
     </DockPanel>
    </Border>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
