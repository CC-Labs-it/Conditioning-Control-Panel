<!-- PORTED from ConditioningControlPanel/Dialogs/WelcomeBackSheet.xaml: same rows, order, sizes and
     names. Deviations, all forced: WindowStyle="None" + AllowsTransparency -> SystemDecorations="None" +
     TransparencyLevelHint; ResizeMode -> CanResize; Visibility -> IsVisible; keyed Styles -> Classes
     (property-only, on non-templated Border/TextBlock); handlers wired in code-behind; BtnGo holds a
     TextBlock (trap 1). TxtTour is gone: WPF retired the upgrade tour (WhatsNewDialog.UpgradeTourOffered
     is false, WelcomeBackSheetRenderTests.TheUpgradeTourIsRetired_NeverOfferedEvenWithATourToRun). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ConditioningControlPanel.Avalonia.Views.Dialogs.WelcomeBackSheet"
        Title="Welcome back"
        Width="560" SizeToContent="Height" MinHeight="240" MaxHeight="660"
        WindowStartupLocation="CenterOwner" CanResize="False"
        SystemDecorations="None" TransparencyLevelHint="Transparent"
        Background="Transparent" ShowInTaskbar="False">

  <Window.Styles>
    <Style Selector="Border.wbRow">
      <Setter Property="Background" Value="{DynamicResource PanelBgBrush}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16,13"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style Selector="TextBlock.wbRowLabel">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="TextBlock.wbRowHint">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
  </Window.Styles>

  <Border Background="{DynamicResource DarkerBgBrush}" CornerRadius="12"
          BorderBrush="{DynamicResource PinkBrush}" BorderThickness="2">
    <Grid x:Name="SheetRoot" Margin="26,22,26,22" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">

      <TextBlock x:Name="TxtHeading" Grid.Row="0"
                 Foreground="{DynamicResource PinkBrush}"
                 FontSize="23" FontWeight="Bold" TextWrapping="Wrap"/>

      <TextBlock x:Name="TxtSubline" Grid.Row="1" Margin="0,6,0,20"
                 Foreground="{DynamicResource TextMutedBrush}"
                 FontSize="12.5" TextWrapping="Wrap"/>

      <Border x:Name="RowRestore" Grid.Row="2" Classes="wbRow">
        <Grid ColumnDefinitions="Auto,*">
          <CheckBox x:Name="ChkRestore" Grid.Column="0" IsChecked="True"
                    Theme="{StaticResource ItemCheckBox}"
                    VerticalAlignment="Top" Margin="0,1,14,0"/>
          <StackPanel Grid.Column="1">
            <TextBlock x:Name="TxtRestoreLabel" Classes="wbRowLabel"/>
            <TextBlock x:Name="TxtRestoreHint" Classes="wbRowHint"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border x:Name="RowFlavour" Grid.Row="3" Classes="wbRow">
        <Grid ColumnDefinitions="Auto,*">
          <CheckBox x:Name="ChkFlavour" Grid.Column="0" IsChecked="True"
                    Theme="{StaticResource ItemCheckBox}"
                    VerticalAlignment="Top" Margin="0,1,14,0"/>
          <StackPanel Grid.Column="1">
            <TextBlock x:Name="TxtFlavourLabel" Classes="wbRowLabel"/>
            <TextBlock x:Name="TxtFlavourHint" Classes="wbRowHint"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- What changed, folded away (a toggle line, not an Expander, as WPF). -->
      <StackPanel x:Name="RowWhatsNew" Grid.Row="4" Margin="0,2,0,0">
        <TextBlock x:Name="TxtWhatsNewToggle" Focusable="True"
                   Foreground="{DynamicResource PinkBrush}"
                   FontSize="13" Cursor="Hand" TextWrapping="Wrap"/>
        <Border x:Name="NotesPanel" IsVisible="False" Margin="0,10,0,0"
                Background="{DynamicResource PanelBgBrush}" CornerRadius="8" Padding="12">
          <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="TxtNotes" Foreground="#C0C0C0" FontSize="12.5"
                       TextWrapping="Wrap" LineHeight="19"/>
          </ScrollViewer>
        </Border>
      </StackPanel>

      <TextBlock x:Name="TxtSeasonLine" Grid.Row="5" Margin="0,18,0,0"
                 Foreground="{DynamicResource TextMutedBrush}"
                 FontSize="12" TextWrapping="Wrap" IsVisible="False"/>

      <Button x:Name="BtnGo" Grid.Row="6" Margin="0,22,0,0"
              HorizontalAlignment="Right" Padding="38,11"
              Theme="{StaticResource PinkButton}" IsDefault="True">
        <TextBlock x:Name="TxtGo"/>
      </Button>
    </Grid>
  </Border>
</Window>
