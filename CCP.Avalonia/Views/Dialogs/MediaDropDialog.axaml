<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ConditioningControlPanel.Avalonia.Localization"
        x:Class="ConditioningControlPanel.Avalonia.Views.Dialogs.MediaDropDialog"
        Width="460" SizeToContent="Height" MinHeight="240" MaxHeight="600"
        WindowStartupLocation="CenterOwner" CanResize="False" WindowDecorations="None"
        Background="Transparent" TransparencyLevelHint="Transparent">
    <!-- WPF MainWindow.Presets.cs:822-925: filename, Play, Edit, Library, Cancel. -->
    <Border Background="{DynamicResource DarkerBgBrush}" BorderBrush="{DynamicResource PinkBrush}" BorderThickness="2" CornerRadius="12" Padding="20">
        <StackPanel>
            <TextBlock Text="{loc:Str dlg_media_drop_title}" Foreground="{DynamicResource PinkBrush}"
                       FontSize="18" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock x:Name="TxtFileName" Foreground="{DynamicResource TextLightBrush}"
                       FontSize="12" Opacity="0.75" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
            <Button x:Name="BtnPlay" Theme="{StaticResource ActionButton}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Stretch" Padding="20,12" Margin="0,0,0,8">
                <TextBlock Text="{loc:Str dlg_media_drop_play}"/>
            </Button>
            <Button x:Name="BtnEdit" Theme="{StaticResource ActionButton}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Stretch" Padding="20,12" Margin="0,0,0,8">
                <TextBlock Text="{loc:Str dlg_media_drop_edit}"/>
            </Button>
            <Button x:Name="BtnOk" Theme="{StaticResource ActionButton}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Stretch" Padding="20,12" Margin="0,0,0,8">
                <TextBlock Text="{loc:Str dlg_media_drop_library}"/>
            </Button>
            <Button x:Name="BtnCancel" Theme="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Padding="8,6" Margin="0,8,0,0" FontSize="11" FontWeight="Normal" Background="Transparent" Opacity="0.7">
                <TextBlock Text="{loc:Str dlg_media_drop_cancel}"/>
            </Button>
        </StackPanel>
    </Border>
</Window>
