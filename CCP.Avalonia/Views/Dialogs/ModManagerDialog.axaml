<!-- PORTED from ConditioningControlPanel/Dialogs/ModManagerDialog.xaml (the 2026-09-24 "Customise"
     redesign, c56f1693c7 / c269cb947e). Structure, ordering, spacing and every resource key preserved
     so the two diff cleanly. Deviations, all forced:

       AllowsTransparency="True" / WindowStyle="None"
                                      -> TransparencyLevelHint="Transparent" + SystemDecorations="None"
       ResizeMode="NoResize"          -> CanResize="False"
       Visibility="Collapsed"         -> IsVisible="False"
       ItemContainerStyle             -> ItemContainerTheme + a keyed ControlTheme
       <Style x:Key TargetType>       -> <ControlTheme x:Key TargetType>, applied with Theme=
       ControlTemplate.Triggers       -> ^:pointerover / ^:selected / ^:disabled nested selectors
       <ContentPresenter/>            -> Content="{TemplateBinding Content}" (trap 6: a bare
                                         presenter draws nothing in Avalonia)
       ToolTip="..."                  -> ToolTip.Tip="..."
       MouseLeftButtonDown= / Click=  -> wired in the constructor (BeginMoveDrag / handlers)
       ProgressBar Foreground         -> ProgressBar has no Foreground on Avalonia's Fluent theme;
                                         the indicator colour rides on the packBar style below.
       LinearGradientBrush 0,0 -> 0,1 -> relative 0%,0% -> 0%,100%
       app-wide ContextMenu/MenuItem  -> WPF Inputs.xaml styles every ContextMenu; this head has no
                                         app-wide one, so the overflow menu carries the same setters
                                         in Window.Styles below.

     Buttons carry a TextBlock child rather than Content: Avalonia parses "_" in Content as an
     access key and every loc key here is snake_case (trap 1). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fx="clr-namespace:ConditioningControlPanel.Avalonia.Controls"
        xmlns:loc="clr-namespace:ConditioningControlPanel.Avalonia.Localization"
        xmlns:cmp="clr-namespace:ConditioningControlPanel.Avalonia.Views.Controls.Companion"
        x:Class="ConditioningControlPanel.Avalonia.Views.Dialogs.ModManagerDialog"
        Title="{loc:Str dialog_customise}"
        Width="860" SizeToContent="Height" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

    <!-- CUSTOMISE. One mental model, left to right: pick a MOD (the skin: look, words, voice),
         and the mod carries a COMPANION (look + personality), edited in its own card (or previewed,
         read-only, for a mod not in use). Per-mod default presets are
         dropdowns: a mod's suggestion only pre-selects, the user's choice is what applies. -->
    <Window.Styles>
        <!-- ponytail: local copy of ConditioningControlPanel/Dialogs/ModManagerDialog.xaml:PackProgress
             (WPF set Foreground="{DynamicResource PinkBrush}" straight on the ProgressBar; Avalonia's
             Fluent template paints PART_Indicator instead). Hoist when a second view needs it. -->
        <Style Selector="ProgressBar.packBar /template/ Border#PART_Indicator">
            <Setter Property="Background" Value="{DynamicResource PinkBrush}"/>
        </Style>

        <!-- WPF Resources/Theme/Inputs.xaml:441 (ContextMenu) and :476 (MenuItem), the setters the
             overflow menu inherits there. ponytail: local, hoist into Theme when a second view needs it. -->
        <Style Selector="ContextMenu.modMore">
            <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TransparentPink20Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="ContextMenu.modMore MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ContextMenu.modMore MenuItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource TransparentPink20Brush}"/>
        </Style>
        <Style Selector="ContextMenu.modMore MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
        </Style>
    </Window.Styles>

    <Window.Resources>
        <!-- WPF CcpBtn: the one shared button style of the redesign. -->
        <ControlTheme x:Key="CcpBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource PanelAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#bd">
                <Setter Property="Opacity" Value="0.85"/>
            </Style>
            <Style Selector="^:disabled /template/ Border#bd">
                <Setter Property="Opacity" Value="0.45"/>
            </Style>
        </ControlTheme>

        <!-- The WPF ListBox.ItemContainerStyle, setters and template verbatim. -->
        <ControlTheme x:Key="ModListRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="9" BorderThickness="1"
                            BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Margin="0,2">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Stretch"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#Bd">
                <Setter Property="Background" Value="#2A2A4A"/>
            </Style>
            <Style Selector="^:selected /template/ Border#Bd">
                <Setter Property="Background" Value="#2E2944"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
            </Style>
        </ControlTheme>

        <!-- The WPF close button used the stock template with a transparent background; Fluent's
             stock Button paints a hover plate, so it gets the flat template too.
             ponytail: local copy of ModManagerDialog.xaml:BtnClose, hoist when a second view
             needs it. -->
        <ControlTheme x:Key="ModCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#bd">
                <Setter Property="Background" Value="#2A2A4A"/>
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Border Background="{DynamicResource DarkerBgBrush}" CornerRadius="12" BorderBrush="{DynamicResource PinkBrush}" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" x:Name="TitleBar" Background="{DynamicResource PanelBgBrush}" CornerRadius="12,12,0,0" Padding="22,14">
                <Grid>
                    <TextBlock Text="{loc:Str dialog_customise}" Foreground="{DynamicResource PinkBrush}" FontSize="20" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button x:Name="BtnClose" Content="X" Theme="{StaticResource ModCloseButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Foreground="{DynamicResource TextMutedBrush}" FontSize="16" FontWeight="Bold"
                            Padding="8,2"
                            Width="30" Height="30"/>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="18,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Mod list: a dot in each mod's accent, IN USE on the active one -->
                <Border Grid.Column="0" Background="{DynamicResource PanelBgBrush}" CornerRadius="12" Margin="0,0,16,0" Padding="6">
                    <ListBox x:Name="ModList" Background="Transparent" BorderThickness="0"
                             ItemContainerTheme="{StaticResource ModListRow}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Foreground="White" FontSize="14"/>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" MaxHeight="620">
                    <StackPanel x:Name="DetailsPanel" IsVisible="False">

                        <!-- 1. Banner across the top, name and one line over it, the one primary action on its right -->
                        <Border x:Name="BannerPanel" Height="120" CornerRadius="12" ClipToBounds="True"
                                Background="{DynamicResource PanelAccentBrush}" Margin="0,0,0,14">
                            <Grid>
                                <Image x:Name="ImgModPreview" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                <!-- scrim so the name reads over any art -->
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                            <GradientStop Color="#30120F1C" Offset="0"/>
                                            <GradientStop Color="#E6120F1C" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Grid Margin="18,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,12,0">
                                        <TextBlock x:Name="TxtModName" FontSize="28" FontWeight="Bold" Foreground="White"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtModDescription" FontSize="13" Foreground="#D9D2EA" Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtModAuthor" FontSize="11" Foreground="#A9A1C0" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="BtnActivate" Grid.Column="1"
                                            Theme="{StaticResource CcpBtn}" Background="{DynamicResource PinkBrush}"
                                            FontSize="15" FontWeight="Bold" Padding="22,11" VerticalAlignment="Bottom">
                                        <TextBlock Text="{loc:Str modmgr_use_this_mod}"/>
                                    </Button>
                                    <Border x:Name="TxtActiveIndicator" Grid.Column="1" CornerRadius="16" Padding="14,7" Background="#CC1E3A2A"
                                            BorderBrush="#4CAF50" BorderThickness="1" VerticalAlignment="Bottom" IsVisible="False">
                                        <TextBlock Text="{loc:Str modmgr_in_use}" Foreground="#7FF0CB" FontSize="12" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Content pack row: built-in mods whose media (voice lines, portraits,
                             DTRH barks) lives in a release-hosted pack that is not downloaded yet.
                             Hidden entirely on full/dev installs and for user mods. -->
                        <Border x:Name="PackPanel" Background="{DynamicResource PanelBgBrush}" CornerRadius="12"
                                Padding="14" Margin="0,0,0,14" IsVisible="False">
                            <StackPanel>
                                <TextBlock x:Name="TxtPackState" Text="{loc:Str modmgr_pack_not_downloaded}"
                                           Foreground="#FFB347" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{loc:Str modmgr_pack_hint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <ProgressBar x:Name="PackProgress" Classes="packBar" Height="6" Minimum="0" Maximum="100" Value="0"
                                             Background="#252542"
                                             BorderThickness="0" Margin="0,10,0,0" IsVisible="False"/>
                                <Button x:Name="BtnDownloadPack" Theme="{StaticResource CcpBtn}"
                                        Background="{DynamicResource PinkBrush}" FontWeight="SemiBold"
                                        HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 2. The companion this mod carries: live for the mod in use, a read-only preview otherwise -->
                        <cmp:CompanionPickerCard x:Name="CompanionCard" Margin="0,0,0,14"/>

                        <!-- 3. Per-mod defaults: what loads each time you switch to this mod. Shown for the
                             mod in use and for a previewed one, so it can be set before switching. -->
                        <Border Background="{DynamicResource PanelBgBrush}" CornerRadius="12" Padding="14,10"
                                BorderBrush="{DynamicResource PanelAccentBrush}" BorderThickness="1"
                                ToolTip.Tip="{loc:Str modmgr_defaults_tooltip}">
                            <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{loc:Str modmgr_label_settings_preset}" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="CmbDefaultSettings" Theme="{StaticResource DarkComboBoxStyle}"
                                              Foreground="{DynamicResource TextLightBrush}" MinHeight="30"
                                              HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{loc:Str modmgr_label_asset_preset}" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="CmbDefaultAssets" Theme="{StaticResource DarkComboBoxStyle}"
                                              Foreground="{DynamicResource TextLightBrush}" MinHeight="30"
                                              HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <Button x:Name="BtnQuickLinkLayout" Grid.Column="4"
                                        Theme="{StaticResource CcpBtn}" IsEnabled="False" Padding="14,0" MinHeight="30"
                                        VerticalAlignment="Bottom">
                                    <TextBlock Text="{loc:Str modmgr_dashboard_soon}"/>
                                </Button>
                            </Grid>
                            <!-- Owner, 2026-09-24: a stored preset reloads on EVERY switch, so say so out loud. -->
                            <TextBlock Text="{loc:Str modmgr_defaults_tooltip}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Bottom Bar: get, make, and everything else behind the overflow -->
            <Border Grid.Row="2" Background="{DynamicResource PanelBgBrush}" CornerRadius="0,0,12,12" Padding="18,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="BtnBrowseCatalogue"
                                ToolTip.Tip="{loc:Str tooltip_browse_mod_catalogue}" Theme="{StaticResource CcpBtn}"
                                Padding="16,9" FontSize="13" Margin="0,0,10,0">
                            <fx:IconLabel Key="btn_browse_mod_catalogue"/>
                        </Button>
                        <Button x:Name="BtnCreate"
                                Theme="{StaticResource CcpBtn}" Background="Transparent" BorderBrush="{DynamicResource PinkBrush}" BorderThickness="1"
                                Foreground="{DynamicResource PinkBrush}" FontWeight="Bold" Padding="16,9" FontSize="13">
                            <TextBlock Text="{loc:Str btn_create_new_2}"/>
                        </Button>
                    </StackPanel>
                    <Button x:Name="BtnMore" ToolTip.Tip="{loc:Str modmgr_more}"
                            HorizontalAlignment="Right" Theme="{StaticResource CcpBtn}" FontSize="14" Padding="14,6">
                        <TextBlock Text="..."/>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MoreMenu" Classes="modMore" Placement="Top">
                                <MenuItem x:Name="BtnInstall" Header="{loc:Str btn_install_from_file}"/>
                                <MenuItem x:Name="BtnExport" Header="{loc:Str btn_export_current}"/>
                                <Separator x:Name="SepModActions"/>
                                <MenuItem x:Name="BtnShare" Header="{loc:Str btn_share_mod}"/>
                                <MenuItem x:Name="BtnUninstall" Header="{loc:Str btn_uninstall}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
