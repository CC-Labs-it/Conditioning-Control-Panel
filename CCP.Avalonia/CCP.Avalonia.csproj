<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\ContentPackSounds.props" />
  <Import Project="..\Version.props" />

  <!--
    The cross-platform head. This replaces WPF, it does not sit beside it: the owner's decision is
    one UI codebase for Windows and Linux, so a feature is written once and both platforms get it.

    net10.0 with no -windows suffix and no RuntimeIdentifier, same as CCP.Core, so the target
    framework itself forbids a WPF reference from creeping back in.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>            <!-- 'WinExe' just suppresses the console window; it is not Windows-specific -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ConditioningControlPanel.Avalonia</RootNamespace>
    <AssemblyName>CCP.Avalonia</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
    <!-- What Windows shows for the exe (taskbar, Task Manager, file properties): WPF's values
         (ConditioningControlPanel.csproj:15-19, 36-39), not "CCP.Avalonia". AssemblyTitle is the
         FileDescription the taskbar names the app by; AssemblyName stays CCP.Avalonia (avares:// URIs). -->
    <ApplicationIcon>..\Assets\app.ico</ApplicationIcon>
    <Company>CodeBambi</Company>
    <Product>Conditioning Control Panel</Product>
    <AssemblyTitle>Conditioning Control Panel</AssemblyTitle>
    <Description>A professional visual conditioning application with gamification features.</Description>
    <Copyright>Copyright © 2024-2026 CodeBambi</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ConditioningControlPanel\Services\ChromeFxNav.cs" Link="Services\ChromeFxNav.cs" />
    <!-- Where a subliminal card sits while a mandatory video is up (ccp-bugs #1422): pure z-order rule, one source for both heads. -->
    <Compile Include="..\ConditioningControlPanel\Services\Subliminal\SubliminalOverVideo.cs" Link="Services\Subliminal\SubliminalOverVideo.cs" />
    <!-- The audio player's order rules (list, loop, shuffle): no UI, no audio, one source for both heads. -->
    <Compile Include="..\ConditioningControlPanel\Services\AudioPlayer\AudioPlaylistRules.cs" Link="Services\AudioPlayer\AudioPlaylistRules.cs" />
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <!-- Renders the real window offscreen so CI can prove the Linux head DRAWS, not just boots.
         A desktop screenshot cannot run on a headless runner; this can. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.5" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.5" />
    <!-- The Linux/Windows web view. Wraps WebKitGTK on Linux and WebView2 on Windows, so the
         WPF head's Microsoft.Web.WebView2 dependency does not follow us across. Only Views/Controls/WebHost
         touches it, and that control draws a fallback panel wherever no web view exists. -->
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
    <!-- ColorView, the inline colour panel behind ColorPickerDialog. WPF opened
         System.Windows.Forms.ColorDialog; this is the cross-platform twin. PINNED to the same
         12.1.5 as Avalonia itself - a control package built against a different Avalonia minor
         throws at attach, which no compiler catches. -->
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.5" />
    <!-- Fluent UI System Icons (docs/avalonia-decisions.html, 2026-10-10). Only Controls/Icons/* may
         name FluentIcons.*: every view draws icons through fx:IconGlyph. Built against Avalonia 12.0;
         IconGlyphRenderTests proves it draws on 12.1.5 headless. MIT: ThirdPartyNotices/FluentIcons.txt. -->
    <PackageReference Include="FluentIcons.Avalonia" Version="2.1.343" />
    <Content Include="ThirdPartyNotices\FluentIcons.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Audio (and later video) on both OSes; see docs/avalonia-decisions.html. Linux loads the
         system libvlc (libvlc.so.5); only Windows needs the bundled natives. -->
    <PackageReference Include="LibVLCSharp" Version="3.10.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- Pure managed MP3 decoding for WPF-style sequential quiz loops. -->
    <PackageReference Include="NLayer" Version="1.16.0" />
    <Content Include="ThirdPartyNotices\NLayer.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Vosk speech (Core SpeechEngine): the head references it itself so libvosk ships with it.
         Vosk.targets picks the native lib by the BUILD machine's OS; build Linux releases on Linux. -->
    <PackageReference Include="Vosk" Version="0.3.38" />
    <!-- DPAPI for the Windows secret store (Platform/SecretStore.cs), same package WPF uses. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- Same file sink and version WPF ships (ConditioningControlPanel.csproj:130). -->
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <!-- Remote Control pairing QR, same package and version WPF uses (ConditioningControlPanel.csproj:154). -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- Webcam tracking (Platform/WebcamTracker.cs), docs/avalonia-decisions.html 2026-09-30. 4.13, not
         WPF's 4.9: no Linux runtime exists for 4.9, and 4.10/4.11 link Ubuntu-22.04-only libs (libavcodec58,
         libtiff5, gtk2...); 4.13 needs only glibc 2.28 + GTK3 (ldd: nothing missing). OnnxRuntime carries CPU natives
         for every RID; a RID publish keeps only its own. -->
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows')))">
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
  </ItemGroup>

  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux')))">
    <PackageReference Include="OpenCvSharp4.official.runtime.linux-x64" Version="4.13.0.20260627" />
    <!-- OnnxRuntime's props copy the win-x64 onnxruntime.dll to the root on any AnyCPU build (11 MB of
         Windows native in the Linux tarball). -->
    <None Remove="$(NuGetPackageRoot)microsoft.ml.onnxruntime/1.20.1/runtimes/win-x64/native/*.dll" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF ChaosArt loads these from disk (ConditioningControlPanel.csproj:217).
         Ship the overlay's promoted art at the same paths, including in single-file publishes. -->
    <Content Include="..\ConditioningControlPanel\assets\Chaos\menu.png;..\ConditioningControlPanel\assets\Chaos\menu_1.png;..\ConditioningControlPanel\assets\Chaos\menu_2.png;..\ConditioningControlPanel\assets\Chaos\menu_3.png;..\ConditioningControlPanel\assets\Chaos\menu_4.png;..\ConditioningControlPanel\assets\Chaos\menu_5.png;..\ConditioningControlPanel\assets\Chaos\menu_6.png;..\ConditioningControlPanel\assets\Chaos\banner.png"
             Link="assets\Chaos\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\ConditioningControlPanel\assets\Chaos\bubbles\tease.png" Link="assets\Chaos\bubbles\tease.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\ConditioningControlPanel\assets\Chaos\recap.png" Link="assets\Chaos\recap.png"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\ConditioningControlPanel\assets\Chaos\boons\*.png"
             Link="assets\Chaos\boons\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\ConditioningControlPanel\assets\Chaos\portraits\*.png"
             Link="assets\Chaos\portraits\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- The shared sounds at the same logical path as the WPF head (Resources\sounds), minus the
         content-pack audio in ..\ContentPackSounds.props, which both heads import. WPF's temporary
         $(CirceNeutralInBoxOverride) is mirrored further down: this head now runs the pack
         downloader (App ReleaseContentService) and the bark path (BarkHead), so without it a Linux
         Circe plays the stale mod-locked pack clips. -->
    <Content Include="..\Assets\sounds\**\*" Link="Resources\sounds\%(RecursiveDir)%(Filename)%(Extension)"
             Exclude="$(ContentPackSoundsExclude)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <!-- WPF CopyCirceNeutralOverrides* (csproj :885): CirceNeutralPackPatch re-applies these after every
         builtin-locked re-extract. A profile moved from Windows always re-extracts (the archive path
         changed), so without them the neutral voice lines and art reverted (real-profile migration test).
         None, not Content: VideoLAN.LibVLC.Windows.targets feeds every Content path to MakeRelative, and
         a file name with a comma breaks that call (MSB4186 on Windows). -->
    <None Include="..\ConditioningControlPanel\LockedMod\overrides\**\*" Link="LockedMod\overrides\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
    <!-- WPF CornerGifMedia's built-in corner asset (pre-scaled), CornerGifOverlay's fallback. -->
    <Content Include="..\Assets\spiral_corner.gif" Link="Resources\spiral_corner.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <!-- One icon per launcher tile beside the exe: a desktop shortcut cannot read an embedded resource
         (WPF csproj :614, Core LauncherShortcuts.IconFolder). -->
    <Content Include="..\Assets\launcher-icons\*.ico" Link="Resources\launcher-icons\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <!-- The shipped spiral (WPF Resources\spiral.gif): SpiralOverlay's default and the card's Default thumbnail. -->
    <Content Include="..\Assets\spiral.gif" Link="Resources\spiral.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <!-- The exe's Spirals folder (WPF csproj :708 ships Spirals\spiral.gif, the same bytes): the session
         delayed-start guard (SessionRunner, WPF SessionEngine.cs:826) needs a gif there on a default install. -->
    <Content Include="..\Assets\spiral.gif" Link="Spirals\spiral.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <!-- Subliminal whispers (SubliminalWhisper.FindLinkedAudio): the shared Bambi clips and the
         neutral voice's words.json + clips, at the WPF head's logical paths. -->
    <Content Include="..\Assets\sub_audio\**\*" Link="Resources\sub_audio\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <!-- The web pages (intake, dtrh, arcademy, codex chapters, ...), served by WebAssetServer on loopback in place of
         WPF's WebView2 virtual hosts. Same subset WPF ships (ConditioningControlPanel.csproj ArcademyHarnessExclude,
         RemixTestExclude, ContentPackWebExclude): dev harnesses, node tests, notes and content-pack mp3s stay out. -->
    <Content Include="..\Assets\web\**\*" Link="Resources\web\%(RecursiveDir)%(Filename)%(Extension)"
             Exclude="..\Assets\web\**\*.md;..\Assets\web\**\smoke\**\*;..\Assets\web\**\tests\**\*;..\Assets\web\remix\test\**\*;
                      ..\Assets\web\**\*demo.html;..\Assets\web\backroom\stations\breakout\**\*.test.js;
                      ..\Assets\web\backroom\stations\breakout\dev.html;..\Assets\web\backroom\stations\breakout\showcase*;
                      ..\Assets\web\piecebypiece\dev\**\*;..\Assets\web\piecebypiece\package.json;
                      ..\Assets\web\prizecounter\mock\**\*;..\Assets\web\prizecounter\dev.html;
                      ..\Assets\web\intake\assets\vo\**\*.mp3;..\Assets\web\intake\assets\sfx\**\*.mp3;
                      ..\Assets\web\intake\assets\music\**\*.mp3;..\Assets\web\dtrh\assets\**\*.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\Assets\Audio\backroom\words\**\*" Link="Resources\Audio\backroom\words\%(RecursiveDir)%(Filename)%(Extension)" Exclude="..\Assets\Audio\**\README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <!-- Keincheck: an MCP server inside the running app so an AI agent can inspect and drive the
       real UI (tree, properties, clicks, screenshots) on http://127.0.0.1:3001. Debug only - a
       server that can click and type in the app has no business in a Release build. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Keincheck" Version="0.12.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ported palette keeps the .xaml extension it has in the WPF head, so a diff against
         ConditioningControlPanel/Resources/Theme/ stays readable. The SDK only globs *.axaml,
         hence the explicit include. -->
    <AvaloniaResource Include="Theme\**\*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The app's art, LINKED from the shared /Assets root that every head draws on. One set of
      bytes on disk, one place to edit them, and no head owns them - the WPF head links them the
      same way and is not a dependency of this one. CCP.VR and a future mobile head add their own
      link with whatever item type they need; nothing here has to change for them.

      The logical path is preserved on both sides, so a reference reads the same on either head:

          WPF       pack://application:,,,/Resources/features/awareness.png
          Avalonia  avares://CCP.Avalonia/Resources/features/awareness.png

      Scoped to what the views actually name, measured from the 113 pack:// URIs in the WPF
      source; about 104 MB with achievements/ and exclusives/ (du -cb over the Include globs below). Deliberately NOT the whole 1.3 GB Resources tree:

        - Twemoji (4,009 files, 19 MB) is not shipped. Icons are Fluent UI System Icons drawn
          through fx:IconGlyph (Controls/Icons); emoji stay only in content (chat, user data).
          Do not add emoji TextBlocks as icons.
        - skills/ (27 files, 4 MB) is globbed: every tree node draws its art. achievements/
          (70 files, 38 MB) is globbed: AchievementPopup can show any of them.
        - Audio, video, models and mod assets are Content in the WPF head - loaded off disk at
          runtime, not compiled in - so they are not resources here either.

      Folders where the views use everything are globbed, so a new file is picked up without a
      csproj edit. Folders where they use a fraction are explicit, so growth stays a decision.
    -->
    <!-- desk-lines.json ships through the Assets/emi glob below (WPF ConditioningControlPanel.csproj:665). -->
    <AvaloniaResource Include="..\Assets\quests\**\*"
                      Link="Resources\quests\%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\Assets\nav\**\*"
                      Link="Resources\nav\%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\Assets\intake\**\*"
                      Link="Resources\intake\%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\Assets\haptics_guide\**\*"
                      Link="Resources\haptics_guide\%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\Assets\lockdown\**\*"
                      Link="Resources\lockdown\%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\Assets\descent\**\*"
                      Link="Resources\descent\%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\Assets\exclusives\**\*"
                      Link="Resources\exclusives\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Home dashboard billboard posters (WPF csproj :411, Core DashboardBillboard roster). -->
    <AvaloniaResource Include="..\Assets\billboard\*.png"
                      Link="Resources\billboard\%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\Assets\features\*.png"
                      Link="Resources\features\%(Filename)%(Extension)" />
    <!-- WPF csproj:471 session-complete cards (recap card, Presets chip, Mod Creator Cards slots; ModArt fallback). -->
    <AvaloniaResource Include="..\Assets\Cards\*.png" Link="Resources\Cards\%(Filename)%(Extension)" />
    <!-- WPF csproj:198-205 shipped AI personality presets: both pickers read BaseDirectory/assets/prompts. -->
    <Content Include="..\ConditioningControlPanel\assets\prompts\*.json" Link="assets\prompts\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <AvaloniaResource Include="..\Assets\BlinkTrainer\Demo\*.png"
                      Link="Resources\BlinkTrainer\Demo\%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\Assets\app.ico" Link="Resources\app.ico" />
    <!-- Header Sparkle wallet's croupier EMI (WPF SparkleWallet.xaml:34-39). -->
    <AvaloniaResource Include="..\Assets\emi\wallet_croupier_*.png" Link="Resources\emi\%(Filename)%(Extension)" />
    <!-- WPF EmiFace.PixelFont's shipped Press Start 2P (Resources/emi/fonts), for the ring cards. -->
    <AvaloniaResource Include="..\Assets\emi\fonts\*.ttf" Link="Resources\emi\fonts\%(Filename)%(Extension)" />
    <!-- App fonts (Platform/AppFonts.cs, distro-check F1/F4): WPF's display face Fredoka (OFL) and a
         monochrome Noto Emoji (OFL) for content emoji when the system has no emoji font; Noto Sans Mono
         (AppFonts.Mono) is the app-wide monospace. Licenses ship
         next to the binary. -->
    <!-- Fredoka as static instances (Light..Bold) cut from WPF's variable Fredoka.ttf (OFL, no Reserved Font Name):
         Avalonia draws a variable font at its default (Light, 300) whatever the FontWeight; WPF/DirectWrite picks the
         named instance. Regenerate with fontTools instancer when WPF's file changes (2026-11-06). -->
    <AvaloniaResource Include="..\Assets\fonts\fredoka\*.ttf" Link="Resources\fonts\fredoka\%(Filename)%(Extension)" />
    <!-- WPF unlock-card art convention, without staging artwork. -->
    <Content Include="..\ConditioningControlPanel\assets\Chaos\upgrades\*.png"
             Link="assets\Chaos\upgrades\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="..\ConditioningControlPanel\assets\Chaos\guide\intro.png" Link="Resources\chaos\guide\intro.png" />
    <!-- WPF ChaosAnnouncerOverlay.cs:177-195: shared announce word-art. -->
    <Content Include="..\ConditioningControlPanel\assets\Chaos\announce\*.png" Link="assets\Chaos\announce\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <AvaloniaResource Include="..\Assets\fonts\NotoEmoji-wght.ttf" Link="Resources\fonts\NotoEmoji-wght.ttf" />
    <!-- Off-Windows look-alikes for WPF's Windows faces (AppFonts.Options, 2026-11-06): Selawik (Microsoft's
         OFL Segoe UI fallback, metric-compatible), Anton for Impact, Comic Neue for Comic Sans MS. Own folders,
         so each avares family source only scans its own faces. -->
    <AvaloniaResource Include="..\Assets\fonts\ccpsans\*.ttf" Link="Resources\fonts\ccpsans\%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\Assets\fonts\display\*.ttf" Link="Resources\fonts\display\%(Filename)%(Extension)" />
    <Content Include="..\ConditioningControlPanel\Fonts\OFL-Fredoka.txt;..\Assets\fonts\OFL-NotoEmoji.txt;..\Assets\emi\fonts\OFL-NotoSansMono.txt;..\Assets\fonts\OFL-CCPSans.txt;..\Assets\fonts\OFL-Anton.txt;..\Assets\fonts\OFL-ComicNeue.txt" Link="ThirdPartyNotices\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- WPF ConditioningControlPanel.csproj:393-394: the V1 avatar0 emote set (BambiSleep, Sissy, CCP Default) plays on the tube. -->
    <AvaloniaResource Include="..\Assets\avatar0_emotes\*.gif;..\Assets\avatar0_emotes\emotes.json" Link="Resources\avatar0_emotes\%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\Assets\circe_emotes\idle.gif" Link="Resources\circe_emotes\idle.gif" />
    <AvaloniaResource Include="..\Assets\circe_emotes_p2\idle.gif" Link="Resources\circe_emotes_p2\idle.gif" />
    <AvaloniaResource Include="..\Assets\circe_emotes_p3\idle.gif" Link="Resources\circe_emotes_p3\idle.gif" />
    <AvaloniaResource Include="..\Assets\circe_emotes_p4\idle.gif" Link="Resources\circe_emotes_p4\idle.gif" />
    <AvaloniaResource Include="..\Assets\rain_emotes\*.webp;..\Assets\rain_emotes\*.json;..\Assets\rain_emotes\ATTRIBUTION.txt" Link="Resources\rain_emotes\%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\Assets\avatar_emotes_registry.json" Link="Resources\avatar_emotes_registry.json" />
    <AvaloniaResource Include="..\Assets\*.png"
                      Link="Resources\%(Filename)%(Extension)" />
    <!-- The animated dashboard logo (WPF ConditioningControlPanel.csproj:272) and its renderer, one
         SkiaSharp source compiled into both heads rather than a second copy. -->
    <AvaloniaResource Include="..\Assets\branding\ccp-logo.jpg" Link="Resources\branding\ccp-logo.jpg" />
    <Compile Include="..\ConditioningControlPanel\Controls\DashboardLogoRenderer.cs" Link="Controls\DashboardLogoRenderer.cs" />

    <AvaloniaResource Include="..\Assets\achievements\*.png"
                      Link="Resources\achievements\%(Filename)%(Extension)" />
    <!-- Profile hero banners (Core CosmeticsPool.Banners), compiled in as WPF ConditioningControlPanel.csproj:436. -->
    <AvaloniaResource Include="..\Assets\banners\*.png"
                      Link="Resources\banners\%(Filename)%(Extension)" />
    <!-- Program art (Core ProgramArtPaths), single level like WPF ConditioningControlPanel.csproj:426.
         hero_*.png is the read-only run view's Today band (ProgramArtPaths.DayHero). -->
    <AvaloniaResource Include="..\Assets\programs\banner_*.png;..\Assets\programs\sigil_*.png;..\Assets\programs\plate_*.png;..\Assets\programs\hero_*.png"
                      Link="Resources\programs\%(Filename)%(Extension)" />
    <!-- Sparse folders: only what a view names. -->
    <!-- Every skill node draws its art (WPF CreateSkillNode skills/{id}.png). -->
    <AvaloniaResource Include="..\Assets\skills\*.png" Link="Resources\skills\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built-in sessions are runtime JSON, not Avalonia resources. Match WPF's lowercase
         assets/sessions output path so Core's loader sees the same files on every head. -->
    <Content Include="..\Assets\sessions\*.session.json"
             Link="assets\sessions\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <!-- The banner line pool (Core BannerPoolService reads Resources/banner/lines.<lang>.json), as WPF csproj:661. -->
    <Content Include="..\Assets\banner\*.json" Link="Resources\banner\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Deeper demo enhancements: Core EnhancementLibrary seeds Resources/DeeperDemos/*.ccpenh.json into the
         user's library on first launch; as WPF ConditioningControlPanel.csproj:722. -->
    <Content Include="..\Assets\DeeperDemos\**\*" Link="Resources\DeeperDemos\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <!-- EMI's desk lines: Core EmiLineEngine.FindLinesFile reads Resources/emi/desk-lines.json beside the
         binary (a dev run finds Assets/emi by walking up, a published install cannot); as WPF csproj:690. -->
    <Content Include="..\Assets\emi\**\*.json" Link="Resources\emi\%(RecursiveDir)%(Filename)%(Extension)">
