  <!-- Vosk.targets picks libvosk by the BUILD machine's OS, not the RID, so a linux-x64 publish made on Windows
       shipped the four win-x64 DLLs and no libvosk.so (speech off, build-tarball.sh stops). Whatever the build
       machine, a linux publish gets the package's linux-x64 lib and none of the Windows ones. -->
  <Target Name="VoskLinuxNativeAfterPublish" AfterTargets="Publish" Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <Copy SourceFiles="$(NuGetPackageRoot)vosk\0.3.38\build\lib\linux-x64\libvosk.so" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Delete Files="$(PublishDir)libvosk.dll;$(PublishDir)libgcc_s_seh-1.dll;$(PublishDir)libstdc++-6.dll;$(PublishDir)libwinpthread-1.dll" />
  </Target>

  <!-- Windows single-file publish bundles libvlc.dll and its plugins, where LibVLC cannot load them ("Dll was not
       found"). Same fix as the WPF head (ConditioningControlPanel.csproj CopyLibVLCAfterPublish): the x64 natives go
       loose into publish\libvlc\, which LibVlcAudio points Core.Initialize at. -->
  <Target Name="CopyLibVLCAfterPublish" AfterTargets="Publish" Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <ItemGroup>
      <LibVLCFiles Include="$(NuGetPackageRoot)videolan.libvlc.windows\3.0.24\build\x64\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(LibVLCFiles)" DestinationFolder="$(PublishDir)libvlc\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
