<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Version.props" />

  <!--
    Platform-agnostic engine library. Targets plain net10.0 ON PURPOSE: the target framework
    itself is the architecture test. A net10.0 assembly physically cannot reference
    System.Windows.*, so any WPF/WinForms/Win32 leak into Core becomes a compile error rather
    than a code-review question. Do not add -windows, UseWPF, UseWindowsForms, or a
    RuntimeIdentifier here.

    CA1416 is deliberately NOT suppressed (the app suppresses it) and is escalated to an ERROR
    below. Core is precisely where a Windows-only API call must not compile.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Match the app: it does not use implicit usings. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Must stay ConditioningControlPanel: it is the prefix of every generated resource
         logical name, so hardcoded strings like "ConditioningControlPanel.assets.knowledge.json"
         keep naming the same thing once a resource moves here.
         It does NOT make a moved resource *reachable*. Lookups go through
         Assembly.GetExecutingAssembly() (e.g. Services/AIService/Enrichment/KnowledgeService.cs),
         which returns whichever assembly the calling code was compiled into. Move such a caller
         here without also moving its <EmbeddedResource> and the stream comes back null at
         runtime, with no compile error. Move both, or neither. -->
    <RootNamespace>ConditioningControlPanel</RootNamespace>
    <AssemblyName>CCP.Core</AssemblyName>
    <!-- <Version> comes from ..\Version.props (imported at the top), shared with both heads. Without
         it the dll ships stamped 0.0.0.0, which makes a crash-log assembly version useless. -->
    <!-- Deliberately NOT matching the app, which sets this false and hand-writes
         Properties/AssemblyInfo.cs. That switch turns off the whole GenerateAssemblyInfo
         target, so the app's own <Version> never reaches its dll - measured, it loads as
         0.0.0.0 despite the "auto-generated" comment in its AssemblyInfo.cs. Core keeps
         generation ON so <Version> above is really stamped; AssemblyInfo.cs here declares
         only InternalsVisibleTo, so there is nothing for the generated file to collide with. -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- CA1416 (platform compatibility) is an ERROR here. The app <NoWarn>s it because it is
         deliberately Windows-only; Core is the opposite case, and a warning would be lost
         among the app's ~342 pre-existing ones. Registry/DPAPI/Console.Beep must not compile. -->
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <!-- Services/Fyp/Online/ScrolllerWebGate (moved from the WPF head): the Scrolller licence gate on every WebView2 core,
         shared by both heads (the Avalonia head hooks the core behind its web view's platform handle). Only the managed
         Microsoft.Web.WebView2.Core is used, and only on Windows. Same version as the WPF head. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2535.41" />
    <!-- Discord Rich Presence (Services/Account/DiscordRichPresenceService.cs): the client WPF ships, managed only
         (named pipe on Windows, discord-ipc-N unix socket on Linux). Same version as the WPF head's reference. -->
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <PackageReference Include="Buttplug" Version="5.0.1" />
    <!-- LibVLCSharp (managed only): VideoMetadataCache parses clip lengths for the video length filter.
         3.8.5 = what LibVLCSharp.WPF resolves in the WPF head, so WPF ships unchanged; the Avalonia head
         references 3.10.1 directly and that wins there. Natives come from each head. -->
    <PackageReference Include="LibVLCSharp" Version="3.8.5" />
    <!-- Vosk: the speech engine (Services/Speech/SpeechEngine.cs). Managed side is netstandard2.0.
         Its build/ targets add libvosk to Core's output, picked by the BUILD MACHINE's OS (not the RID),
         and that file copies on to every consumer; heads still reference Vosk themselves. -->
    <PackageReference Include="Vosk" Version="0.3.38" />
    <!-- Webcam detectors (Services/Webcam/FaceModels.cs): managed halves only. Each head brings its
         own OpenCV + ONNX Runtime natives, so nothing native ships from here. -->
    <PackageReference Include="OpenCvSharp4" Version="4.9.0.20240103" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.20.1" />
    <!-- WebRTC data channel for the Goon Game 1v1 transport (Services\GoonGame\GoonWebRtcTransport.cs), moved here
         from the WPF head with the transport; both heads get it transitively.
         Pure managed .NET (BouncyCastle DTLS + its own SCTP stack), MIT, no native libs — so
         it survives the single-file / self-contained publish with no extraction shim.
         DATA CHANNEL ONLY: no media tracks are ever created; mic/cam never cross the wire.
         Verified at coding time on net8.0 + Windows 11 (26200): two in-process peers reach
         `connected` in ~0.85 s, an ordered/reliable channel opens at ~0.97 s, a 60 KB string
         round-trips intact (SCTP fragmentation works), and public STUN yields an srflx
         candidate. See docs/GOON_GAME_PLAN.md "Transport decisions". -->
    <PackageReference Include="SIPSorcery" Version="10.0.14" />
    <!-- SkiaSharp (managed + its own win/mac natives): the compositor layers and text rules in
         Services/Compositor (GlyphFallback.cs). 2.88.8 = what SkiaSharp.Views.WPF pins in the WPF head,
         so WPF ships unchanged; the Avalonia head resolves 3.119.x through Avalonia.Skia and that wins there.
         Linux natives come from each head (Avalonia.Skia brings them; the Core test project references them itself). -->
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
  </ItemGroup>

  <!--
    LIMIT: only non-XAML types are a pure `git mv` into here.

    Every one of the app's 265 `xmlns:x="clr-namespace:ConditioningControlPanel..."`
    declarations (147 .xaml files, 14 distinct namespaces) is written WITHOUT an
    `;assembly=` part - verified, not one carries it. A bare clr-namespace resolves in the
    assembly that is compiling the XAML, i.e. ConditioningControlPanel. So the moment a type
    that XAML names - a converter, an `x:Type` key, an enum bound in markup, a UserControl -
    lands in CCP.Core, that markup fails to compile with MC3074 ("the tag does not exist in
    XML namespace") until every xmlns pointing at its namespace is rewritten to
    `clr-namespace:...;assembly=CCP.Core`.

    That rewrite is per-namespace and repo-wide, so it has to be its own reviewed change.
    Until then: move types no XAML references. Grep the .xaml before moving anything.
  -->
  <ItemGroup>
    <!-- The language data, moved here with LocalizationManager. It reads them from
         AppDomain.CurrentDomain.BaseDirectory/Localization/Languages/, so every head needs them
         in ITS output - and Content with CopyToOutputDirectory flows transitively through a
         ProjectReference, so declaring it once here serves the WPF head, the Avalonia head and
         any future VR head without each repeating the include.

         ExcludeFromSingleFile mirrors the WPF head's original setting: the files must be real
         files on disk for File.ReadAllText, not bundled into a single-file exe. -->
    <Content Include="Localization\Languages\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <!-- Awareness v2 angle cards: the fail-closed floor AwarenessAngleCards reads with
         typeof(AwarenessAngleCards).Assembly, so it lives in the same assembly as that class.
         Each head still ships the on-disk override copy as Content. -->
    <EmbeddedResource Include="..\Assets\sounds\companion_audio\awareness_angles.json" Link="Resources\sounds\companion_audio\awareness_angles.json" />
  </ItemGroup>

</Project>
