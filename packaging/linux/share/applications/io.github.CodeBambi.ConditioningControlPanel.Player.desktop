[Desktop Entry]
Type=Application
Name=CCP Player
Exec=conditioning-control-panel --play %f
Icon=io.github.CodeBambi.ConditioningControlPanel
Terminal=false
NoDisplay=true
MimeType=video/mp4;video/webm;video/x-matroska;video/quicktime;video/x-msvideo;video/x-m4v;audio/mpeg;audio/x-wav;audio/mp4;audio/aac;audio/flac;audio/ogg;
