# Pins for the bundled Linux libVLC runtime. Sourced by build.sh and check.sh.
# Bump VLC_VERSION + VLC_SHA256 together; the contrib libraries are pinned (version + SHA512)
# by VLC's own contrib/src/*/{rules.mak,SHA512SUMS} inside that tarball.
VLC_VERSION=3.0.24
VLC_SHA256=e7cab503d1d7d5849b89d2cf0e1ee60d0ef6d012407791b644b9cfc0cc225fdf
VLC_URL=https://download.videolan.org/pub/videolan/vlc/${VLC_VERSION}/vlc-${VLC_VERSION}.tar.xz

# glibc 2.35 is the documented native floor (docs/avalonia-decisions.html), so build on 22.04.
BUILD_IMAGE=docker.io/library/ubuntu:22.04@sha256:076e7bf82319619f28dd0aa9c02ab34b055ad37100395b4f49a2ffba04fb5e11
# check.sh only uses it to synthesise test clips; nothing from it ships.
CLIP_IMAGE=docker.io/library/alpine:3.22
GLIBC_CEILING=2.35
GLIBCXX_CEILING=3.4.30

# Contrib packages built from source and linked statically into the plugins, so no distro
# FFmpeg soname is involved. Owner decision D1 (2026-11-11): FFmpeg keeps its H.264/HEVC/AAC
# decoders, same as VideoLAN.LibVLC.Windows. ebml/matroska = the mkv/WebM demuxer, dvbpsi = the
# MPEG-TS demuxer (LGPL-2.1).
CONTRIB_PKGS="ffmpeg zlib gsm openjpeg mpg123 ogg vorbis opus flac vpx dav1d soxr ebml matroska dvbpsi"

ARTIFACT=ccp-vlc-runtime-${VLC_VERSION}-linux-x64

# The published runtime (GitHub release assets, owner decision D2 2026-11-11). When RUNTIME_URL is set,
# build-tarball.sh fetches it and requires RUNTIME_SHA256; empty = bundle a local build.sh runtime that
# check.sh passed (the pins below are then unused). Set all three after check.sh passes on the published build.
RUNTIME_URL=
RUNTIME_SHA256=c3bf4c366fcfa20f927121ea0b668cf36ea7f0671eda55f7ce38f0228103eca6
SOURCES_SHA256=bafc2b9f82917cddd5a5a8c4bc12bfbc0cf6747eadf1b3d6b24ba92f00a9cbec
