<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for CCP.Core. Plain net10.0 with no RuntimeIdentifier and no UseWPF, deliberately:
    this project must be runnable by the core-linux CI job, which is the anti-drift check.
    Adding -windows / win-x64 / UseWPF here would make it unrunnable on Linux and quietly
    delete that signal. Package versions match Tests/ConditioningControlPanel.Tests.

    Core persistence/lifecycle tests run here on Linux; keep this project headless and runnable
    without a Windows runtime. See .github/workflows/build.yml.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <AssemblyName>CCP.Core.Tests</AssemblyName>
    <RootNamespace>CCP.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The ledger is now shared Core logic: run its existing WPF-source boundary tests on Linux too. -->
    <Compile Include="..\ConditioningControlPanel.Tests\AwarenessLedgerTests.cs" Link="AwarenessLedgerTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Copies libvosk next to the tests; Core's copy does not flow through the ProjectReference. -->
    <PackageReference Include="Vosk" Version="0.3.38" />
    <!-- libSkiaSharp for Linux (Core's SkiaSharp brings only the win/mac natives): compositor layer tests and
         GlyphFallbackRunTests. The full package (not .NoDependencies) so fontconfig glyph fallback works. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CCP.Core\CCP.Core.csproj" />
    <Compile Include="..\ConditioningControlPanel.Tests\PatreonActivationTests.cs" Link="PatreonActivationTests.cs" />
    <Compile Include="..\ConditioningControlPanel.Tests\HostNetPathRuleTests.cs" Link="HostNetPathRuleTests.cs" />
    <Compile Include="..\Shared\BackRoomBridgeRig.cs" Link="BackRoomBridgeRig.cs" />
    <Compile Include="..\ConditioningControlPanel.Tests\AchievementSharePromptRuleTests.cs" Link="AchievementSharePromptRuleTests.cs" />
    <!-- Existing pure first-light timeline specs also run on Linux against the shared Core engine. -->
    <Compile Include="..\ConditioningControlPanel.Tests\SpiralFirstLightTimelineTests.cs" Link="SpiralFirstLightTimelineTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The wardrobe registry at the heads' path, for WardrobeCatalogTests (art not needed). -->
    <Content Include="..\..\Assets\cosmetics\registry.json" Link="Resources\cosmetics\registry.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The heads' shipped Spirals folder, so SessionRunnerTests run a default-path spiral like an install. -->
    <Content Include="..\..\Assets\spiral.gif" Link="Spirals\spiral.gif" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
