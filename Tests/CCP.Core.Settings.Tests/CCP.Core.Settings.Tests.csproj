<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>CCP.Core.Settings.Tests</AssemblyName>
    <RootNamespace>CCP.Core.Settings.Tests</RootNamespace>
    <DefineConstants>$(DefineConstants);CCP_ASSEMBLYINFO_GUARD_ONLY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\AvaloniaTestDispatcher.cs" Link="AssemblyInfoStdoutGuard.cs" />
    <Compile Include="..\CCP.Avalonia.Language.Tests\AssemblyInfoDiscoveryTests.cs" Link="AssemblyInfoDiscoveryTests.cs" />
    <ProjectReference Include="..\..\CCP.Core\CCP.Core.csproj" />
  </ItemGroup>
</Project>
